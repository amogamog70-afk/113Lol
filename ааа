local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")

local VoltClips = {}
VoltClips.__index = VoltClips

local BuiltInIcons = {
    ["Legit"]    = "rbxassetid://118624373632520",
    ["HvH"]      = "rbxassetid://78242793290159",
    ["Visuals"]  = "rbxassetid://16475825226",
    ["World"]    = "rbxassetid://11887653877",
    ["Movement"] = "rbxassetid://136160678435000"
}

local Theme = {
    Background = Color3.fromRGB(11, 13, 18),
    Sidebar    = Color3.fromRGB(15, 17, 24),
    Card       = Color3.fromRGB(18, 21, 30),
    CardStroke = Color3.fromRGB(36, 43, 60),
    Element    = Color3.fromRGB(22, 26, 36),
    Accent     = Color3.fromRGB(75, 215, 255),
    Text       = Color3.fromRGB(245, 247, 252),
    SubText    = Color3.fromRGB(115, 125, 145)
}

local function CreateCorner(parent, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 6)
    corner.Parent = parent
    return corner
end

local function CreateStroke(parent, color, thickness, transparency)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color or Theme.CardStroke
    stroke.Thickness = thickness or 1
    stroke.Transparency = transparency or 0.4
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = parent
    return stroke
end

function VoltClips:CreateWindow(hubTitle)
    local Window = {}
    
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "VoltClips_Framework"
    ScreenGui.ResetOnSpawn = false
    
    pcall(function() ScreenGui.Parent = CoreGui end)
    if not ScreenGui.Parent then
        ScreenGui.Parent = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
    end

    -- Главное окно
    local Main = Instance.new("Frame")
    Main.Name = "MainFrame"
    Main.Size = UDim2.new(0, 620, 0, 390)
    Main.Position = UDim2.new(0.5, -310, 0.5, -195)
    Main.BackgroundColor3 = Theme.Background
    Main.BorderSizePixel = 0
    Main.ClipsDescendants = false
    Main.Parent = ScreenGui

    CreateCorner(Main, 10)
    CreateStroke(Main, Theme.CardStroke, 1, 0.2)

    -- Зона Перетаскивания (ТОЛЬКО ВЕРХНЯЯ ШАПКА MENU)
    local DragHeader = Instance.new("Frame")
    DragHeader.Name = "DragHeader"
    DragHeader.Size = UDim2.new(1, 0, 0, 35)
    DragHeader.BackgroundTransparency = 1
    DragHeader.Parent = Main

    local dragging, dragStart, startPos
    DragHeader.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = Main.Position
        end
    end)
    DragHeader.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    -- Левый Сайдбар
    local Sidebar = Instance.new("Frame")
    Sidebar.Name = "Sidebar"
    Sidebar.Size = UDim2.new(0, 50, 1, 0)
    Sidebar.BackgroundColor3 = Theme.Sidebar
    Sidebar.BorderSizePixel = 0
    Sidebar.Parent = Main
    CreateCorner(Sidebar, 10)

    -- Логотип VC
    local Logo = Instance.new("TextLabel")
    Logo.Size = UDim2.new(1, 0, 0, 38)
    Logo.BackgroundTransparency = 1
    Logo.Text = "VC"
    Logo.TextColor3 = Theme.Accent
    Logo.TextSize = 17
    Logo.Font = Enum.Font.GothamBold
    Logo.Parent = Sidebar

    local TabList = Instance.new("Frame")
    TabList.Size = UDim2.new(1, 0, 1, -45)
    TabList.Position = UDim2.new(0, 0, 0, 42)
    TabList.BackgroundTransparency = 1
    TabList.Parent = Sidebar

    local TabListLayout = Instance.new("UIListLayout")
    TabListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    TabListLayout.Padding = UDim.new(0, 12)
    TabListLayout.Parent = TabList

    -- Верхняя панель подвкладок
    local TopBar = Instance.new("Frame")
    TopBar.Name = "TopBar"
    TopBar.Size = UDim2.new(1, -58, 0, 35)
    TopBar.Position = UDim2.new(0, 58, 0, 2)
    TopBar.BackgroundTransparency = 1
    TopBar.Parent = Main

    local SubTabContainer = Instance.new("Frame")
    SubTabContainer.Size = UDim2.new(1, 0, 1, 0)
    SubTabContainer.BackgroundTransparency = 1
    SubTabContainer.Parent = TopBar

    local SubTabLayout = Instance.new("UIListLayout")
    SubTabLayout.FillDirection = Enum.FillDirection.Horizontal
    SubTabLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    SubTabLayout.Padding = UDim.new(0, 6)
    SubTabLayout.Parent = SubTabContainer

    -- Рабочая зона
    local ContentContainer = Instance.new("Frame")
    ContentContainer.Name = "ContentContainer"
    ContentContainer.Size = UDim2.new(1, -64, 1, -45)
    ContentContainer.Position = UDim2.new(0, 58, 0, 40)
    ContentContainer.BackgroundTransparency = 1
    ContentContainer.Parent = Main

    local Tabs = {}
    local PiecesToBreak = {}

    function Window:AddTab(tabName)
        local Tab = { SubTabs = {} }

        local imageUri = BuiltInIcons[tabName]
        if not imageUri then
            local cleanId = tostring(tabName):gsub("%D", "")
            imageUri = (#cleanId > 0) and ("rbxassetid://" .. cleanId) or ""
        end

        local TabBtn = Instance.new("ImageButton")
        TabBtn.Size = UDim2.new(0, 24, 0, 24)
        TabBtn.BackgroundTransparency = 1
        TabBtn.Image = imageUri
        TabBtn.ImageColor3 = Theme.SubText
        TabBtn.ScaleType = Enum.ScaleType.Fit
        TabBtn.AutoButtonColor = false
        TabBtn.Parent = TabList

        Tab.Button = TabBtn

        function Tab:AddSubTab(subName)
            local SubTab = {}

            local SubBtn = Instance.new("TextButton")
            SubBtn.Size = UDim2.new(0, 68, 0, 22)
            SubBtn.BackgroundColor3 = Theme.Card
            SubBtn.BackgroundTransparency = 0.4
            SubBtn.Text = subName
            SubBtn.TextColor3 = Theme.SubText
            SubBtn.Font = Enum.Font.GothamMedium
            SubBtn.TextSize = 11
            SubBtn.Visible = false
            SubBtn.Parent = SubTabContainer
            CreateCorner(SubBtn, 5)

            local Page = Instance.new("Frame")
            Page.Size = UDim2.new(1, -5, 1, 0)
            Page.BackgroundTransparency = 1
            Page.Visible = false
            Page.Parent = ContentContainer

            -- Скролл-колонки с идеально выверенным спавном
            local LeftCol = Instance.new("ScrollingFrame")
            LeftCol.Size = UDim2.new(0.49, -2, 1, 0)
            LeftCol.BackgroundTransparency = 1
            LeftCol.ScrollBarThickness = 2
            LeftCol.ScrollBarImageColor3 = Theme.Accent
            LeftCol.ScrollBarImageTransparency = 0.6
            LeftCol.BorderSizePixel = 0
            LeftCol.AutomaticCanvasSize = Enum.AutomaticSize.Y
            LeftCol.CanvasSize = UDim2.new(0, 0, 0, 0)
            LeftCol.Parent = Page

            local RightCol = Instance.new("ScrollingFrame")
            RightCol.Size = UDim2.new(0.49, -2, 1, 0)
            RightCol.Position = UDim2.new(0.51, 0, 0, 0)
            RightCol.BackgroundTransparency = 1
            RightCol.ScrollBarThickness = 2
            RightCol.ScrollBarImageColor3 = Theme.Accent
            RightCol.ScrollBarImageTransparency = 0.6
            RightCol.BorderSizePixel = 0
            RightCol.AutomaticCanvasSize = Enum.AutomaticSize.Y
            RightCol.CanvasSize = UDim2.new(0, 0, 0, 0)
            RightCol.Parent = Page

            local LList = Instance.new("UIListLayout")
            LList.Padding = UDim.new(0, 8)
            LList.Parent = LeftCol

            local RList = Instance.new("UIListLayout")
            RList.Padding = UDim.new(0, 8)
            RList.Parent = RightCol

            local LPadd = Instance.new("UIPadding")
            LPadd.PaddingRight = UDim.new(0, 4)
            LPadd.Parent = LeftCol

            local RPadd = Instance.new("UIPadding")
            RPadd.PaddingRight = UDim.new(0, 4)
            RPadd.Parent = RightCol

            SubTab.Button = SubBtn
            SubTab.Page = Page

            function SubTab:AddSection(secTitle, side)
                local Section = {}
                local TargetCol = (side == "right") and RightCol or LeftCol

                local Card = Instance.new("Frame")
                Card.Name = "CardSection"
                Card.Size = UDim2.new(1, 0, 0, 36)
                Card.BackgroundColor3 = Theme.Card
                Card.BackgroundTransparency = 0.15
                Card.Parent = TargetCol
                CreateCorner(Card, 8)
                CreateStroke(Card, Theme.CardStroke, 1, 0.4)

                table.insert(PiecesToBreak, Card)

                local TitleLabel = Instance.new("TextLabel")
                TitleLabel.Size = UDim2.new(1, -16, 0, 22)
                TitleLabel.Position = UDim2.new(0, 10, 0, 4)
                TitleLabel.BackgroundTransparency = 1
                TitleLabel.Text = secTitle
                TitleLabel.TextColor3 = Theme.Text
                TitleLabel.Font = Enum.Font.GothamBold
                TitleLabel.TextSize = 11
                TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
                TitleLabel.Parent = Card

                local Container = Instance.new("Frame")
                Container.Size = UDim2.new(1, -20, 1, -30)
                Container.Position = UDim2.new(0, 10, 0, 28)
                Container.BackgroundTransparency = 1
                Container.Parent = Card

                local CList = Instance.new("UIListLayout")
                CList.Padding = UDim.new(0, 8)
                CList.Parent = Container

                local function UpdateSize()
                    Card.Size = UDim2.new(1, 0, 0, CList.AbsoluteContentSize.Y + 36)
                end
                CList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(UpdateSize)

                -- 1. КНОПКА
                function Section:AddButton(text, callback)
                    local Btn = Instance.new("TextButton")
                    Btn.Size = UDim2.new(1, 0, 0, 26)
                    Btn.BackgroundColor3 = Theme.Element
                    Btn.Text = text
                    Btn.TextColor3 = Theme.Text
                    Btn.Font = Enum.Font.GothamMedium
                    Btn.TextSize = 11
                    Btn.AutoButtonColor = false
                    Btn.Parent = Container
                    CreateCorner(Btn, 6)
                    local btnStroke = CreateStroke(Btn, Theme.CardStroke, 1, 0.5)

                    Btn.MouseEnter:Connect(function()
                        TweenService:Create(Btn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Card}):Play()
                        TweenService:Create(btnStroke, TweenInfo.new(0.15), {Color = Theme.Accent, Transparency = 0.2}):Play()
                    end)
                    Btn.MouseLeave:Connect(function()
                        TweenService:Create(Btn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Element}):Play()
                        TweenService:Create(btnStroke, TweenInfo.new(0.15), {Color = Theme.CardStroke, Transparency = 0.5}):Play()
                    end)

                    Btn.MouseButton1Click:Connect(function()
                        TweenService:Create(Btn, TweenInfo.new(0.08), {BackgroundColor3 = Theme.Accent}):Play()
                        task.wait(0.08)
                        TweenService:Create(Btn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Card}):Play()
                        if callback then callback() end
                    end)
                    
                    UpdateSize()
                end

                -- 2. ГАЛОЧКА (TOGGLE)
                function Section:AddToggle(text, default, callback)
                    local active = default or false

                    local TFrame = Instance.new("Frame")
                    TFrame.Size = UDim2.new(1, 0, 0, 22)
                    TFrame.BackgroundTransparency = 1
                    TFrame.Parent = Container

                    local Label = Instance.new("TextLabel")
                    Label.Size = UDim2.new(1, -42, 1, 0)
                    Label.BackgroundTransparency = 1
                    Label.Text = text
                    Label.TextColor3 = active and Theme.Accent or Theme.SubText
                    Label.Font = Enum.Font.GothamMedium
                    Label.TextSize = 11
                    Label.TextXAlignment = Enum.TextXAlignment.Left
                    Label.Parent = TFrame

                    local SwitchBg = Instance.new("TextButton")
                    SwitchBg.Size = UDim2.new(0, 32, 0, 16)
                    SwitchBg.Position = UDim2.new(1, -32, 0.5, -8)
                    SwitchBg.BackgroundColor3 = active and Theme.Accent or Theme.Element
                    SwitchBg.Text = ""
                    SwitchBg.AutoButtonColor = false
                    SwitchBg.Parent = TFrame
                    CreateCorner(SwitchBg, 8)
                    CreateStroke(SwitchBg, Theme.CardStroke, 1, 0.4)

                    local Knob = Instance.new("Frame")
                    Knob.Size = UDim2.new(0, 12, 0, 12)
                    Knob.Position = active and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6)
                    Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                    Knob.Parent = SwitchBg
                    CreateCorner(Knob, 6)

                    SwitchBg.MouseButton1Click:Connect(function()
                        active = not active
                        TweenService:Create(SwitchBg, TweenInfo.new(0.2), {BackgroundColor3 = active and Theme.Accent or Theme.Element}):Play()
                        TweenService:Create(Label, TweenInfo.new(0.2), {TextColor3 = active and Theme.Accent or Theme.SubText}):Play()
                        TweenService:Create(Knob, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                            Position = active and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6)
                        }):Play()
                        if callback then callback(active) end
                    end)

                    UpdateSize()
                end

                -- 3. СЛАЙДЕР (3 ЕДИНИЦЫ: %, m, ИЛИ БЕЗ НИЧЕГО)
                function Section:AddSlider(text, min, max, default, unit, callback)
                    if type(unit) == "function" then
                        callback = unit
                        unit = ""
                    end
                    unit = unit or ""

                    local val = default or min

                    local SFrame = Instance.new("Frame")
                    SFrame.Size = UDim2.new(1, 0, 0, 26)
                    SFrame.BackgroundTransparency = 1
                    SFrame.Parent = Container

                    local Title = Instance.new("TextLabel")
                    Title.Size = UDim2.new(0.42, 0, 1, 0)
                    Title.BackgroundTransparency = 1
                    Title.Text = text
                    Title.TextColor3 = Theme.SubText
                    Title.Font = Enum.Font.GothamMedium
                    Title.TextSize = 11
                    Title.TextXAlignment = Enum.TextXAlignment.Left
                    Title.Parent = SFrame

                    local RightGroup = Instance.new("Frame")
                    RightGroup.Size = UDim2.new(0.58, 0, 1, 0)
                    RightGroup.Position = UDim2.new(0.42, 0, 0, 0)
                    RightGroup.BackgroundTransparency = 1
                    RightGroup.Parent = SFrame

                    local ValueBoxFrame = Instance.new("Frame")
                    ValueBoxFrame.Size = UDim2.new(0, 42, 0, 18)
                    ValueBoxFrame.Position = UDim2.new(1, -42, 0.5, -9)
                    ValueBoxFrame.BackgroundColor3 = Theme.Element
                    ValueBoxFrame.Parent = RightGroup
                    CreateCorner(ValueBoxFrame, 5)
                    CreateStroke(ValueBoxFrame, Theme.CardStroke, 1, 0.4)

                    local ValueInput = Instance.new("TextBox")
                    ValueInput.Size = UDim2.new(1, 0, 1, 0)
                    ValueInput.BackgroundTransparency = 1
                    ValueInput.Text = tostring(val) .. unit
                    ValueInput.TextColor3 = Theme.Accent
                    ValueInput.Font = Enum.Font.GothamBold
                    ValueInput.TextSize = 10
                    ValueInput.Parent = ValueBoxFrame

                    local Bar = Instance.new("Frame")
                    Bar.Size = UDim2.new(1, -50, 0, 3)
                    Bar.Position = UDim2.new(0, 0, 0.5, -1)
                    Bar.BackgroundColor3 = Theme.Element
                    Bar.Parent = RightGroup
                    CreateCorner(Bar, 2)

                    local Fill = Instance.new("Frame")
                    Fill.Size = UDim2.new((val - min)/(max - min), 0, 1, 0)
                    Fill.BackgroundColor3 = Theme.Accent
                    Fill.Parent = Bar
                    CreateCorner(Fill, 2)

                    local Knob = Instance.new("Frame")
                    Knob.Size = UDim2.new(0, 9, 0, 9)
                    Knob.Position = UDim2.new(1, -4, 0.5, -4)
                    Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                    Knob.Parent = Fill
                    CreateCorner(Knob, 5)

                    local function setVal(newVal)
                        val = math.clamp(math.floor(newVal), min, max)
                        ValueInput.Text = tostring(val) .. unit
                        local pos = (val - min) / (max - min)
                        TweenService:Create(Fill, TweenInfo.new(0.08), {Size = UDim2.new(pos, 0, 1, 0)}):Play()
                        if callback then callback(val) end
                    end

                    ValueInput.FocusLost:Connect(function()
                        local cleanText = ValueInput.Text:gsub("%D", "")
                        local num = tonumber(cleanText)
                        if num then
                            setVal(num)
                        else
                            ValueInput.Text = tostring(val) .. unit
                        end
                    end)

                    local sliding = false
                    Bar.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then
                            sliding = true
                            local pos = math.clamp((input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
                            setVal(min + ((max - min) * pos))
                        end
                    end)
                    UserInputService.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end
                    end)
                    UserInputService.InputChanged:Connect(function(input)
                        if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then
                            local pos = math.clamp((input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
                            setVal(min + ((max - min) * pos))
                        end
                    end)

                    UpdateSize()
                end

                -- 4. ТЕКСТБОКС
                function Section:AddTextBox(text, placeholder, callback)
                    local TBoxFrame = Instance.new("Frame")
                    TBoxFrame.Size = UDim2.new(1, 0, 0, 24)
                    TBoxFrame.BackgroundColor3 = Theme.Element
                    TBoxFrame.Parent = Container
                    CreateCorner(TBoxFrame, 5)
                    local boxStroke = CreateStroke(TBoxFrame, Theme.CardStroke, 1, 0.5)

                    local Input = Instance.new("TextBox")
                    Input.Size = UDim2.new(1, -10, 1, 0)
                    Input.Position = UDim2.new(0, 5, 0, 0)
                    Input.BackgroundTransparency = 1
                    Input.Text = ""
                    Input.PlaceholderText = placeholder or text
                    Input.PlaceholderColor3 = Theme.SubText
                    Input.TextColor3 = Theme.Text
                    Input.Font = Enum.Font.Gotham
                    Input.TextSize = 11
                    Input.TextXAlignment = Enum.TextXAlignment.Left
                    Input.Parent = TBoxFrame

                    Input.Focused:Connect(function()
                        TweenService:Create(boxStroke, TweenInfo.new(0.15), {Color = Theme.Accent, Transparency = 0.2}):Play()
                    end)
                    Input.FocusLost:Connect(function()
                        TweenService:Create(boxStroke, TweenInfo.new(0.15), {Color = Theme.CardStroke, Transparency = 0.5}):Play()
                        if callback then callback(Input.Text) end
                    end)

                    UpdateSize()
                end

                return Section
            end

            SubBtn.MouseButton1Click:Connect(function()
                for _, st in pairs(Tab.SubTabs) do
                    st.Button.TextColor3 = Theme.SubText
                    st.Button.BackgroundColor3 = Theme.Card
                    st.Page.Visible = false
                end
                SubBtn.TextColor3 = Theme.Accent
                SubBtn.BackgroundColor3 = Theme.Sidebar
                Page.Visible = true
            end)

            table.insert(Tab.SubTabs, SubTab)
            if #Tab.SubTabs == 1 then
                SubBtn.TextColor3 = Theme.Accent
                SubBtn.BackgroundColor3 = Theme.Sidebar
                Page.Visible = true
            end

            return SubTab
        end

        TabBtn.MouseButton1Click:Connect(function()
            for _, t in pairs(Tabs) do
                t.Button.ImageColor3 = Theme.SubText
                for _, st in pairs(t.SubTabs) do
                    st.Button.Visible = false
                    st.Page.Visible = false
                end
            end
            TabBtn.ImageColor3 = Theme.Accent

            for _, st in pairs(Tab.SubTabs) do
                st.Button.Visible = true
            end
            if #Tab.SubTabs > 0 then
                Tab.SubTabs[1].Page.Visible = true
                Tab.SubTabs[1].Button.TextColor3 = Theme.Accent
            end
        end)

        table.insert(Tabs, Tab)
        if #Tabs == 1 then
            TabBtn.ImageColor3 = Theme.Accent
        end

        return Tab
    end

    -- Анимация Разрушения на Right Shift
    local isOpen = true
    local animating = false

    local function ToggleMenu()
        if animating then return end
        animating = true

        if isOpen then
            for _, card in pairs(PiecesToBreak) do
                local rx = math.random(-250, 250)
                local ry = math.random(-250, 250)
                local rRot = math.random(-60, 60)

                TweenService:Create(card, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
                    Position = card.Position + UDim2.new(0, rx, 0, ry),
                    Rotation = rRot,
                    BackgroundTransparency = 1
                }):Play()
            end

            TweenService:Create(Main, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                BackgroundTransparency = 1
            }):Play()

            task.wait(0.35)
            Main.Visible = false
            isOpen = false
        else
            Main.Visible = true
            TweenService:Create(Main, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                BackgroundTransparency = 0
            }):Play()

            for _, card in pairs(PiecesToBreak) do
                TweenService:Create(card, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                    Position = UDim2.new(0, 0, card.Position.Y.Scale, card.Position.Y.Offset),
                    Rotation = 0,
                    BackgroundTransparency = 0.15
                }):Play()
            end

            task.wait(0.4)
            isOpen = true
        end

        animating = false
    end

    UserInputService.InputBegan:Connect(function(input, gpe)
        if not gpe and input.KeyCode == Enum.KeyCode.RightShift then
            ToggleMenu()
        end
    end)

    return Window
end

return VoltClips
