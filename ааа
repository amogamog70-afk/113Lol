        end

        function ModalAPI:CreateSlider(sliderOpts)
            return WindowObj:InternalCreateSlider(ModalContent, sliderOpts, 103)
        end

        if builderCallback then
            builderCallback(ModalAPI)
        end
    end

    -- Internal Helper for creating Sliders
    function WindowObj:InternalCreateSlider(parent, opts, customZIndex)
        opts = opts or {}
        local sliderName = opts.Name or "Slider"
        local minVal = opts.Min or 0
        local maxVal = opts.Max or 100
        local defaultVal = math.clamp(opts.Default or minVal, minVal, maxVal)
        local decimals = opts.Decimals or 0
        local callback = opts.Callback or function() end
        local zIdx = customZIndex or 1

        local SliderFrame = Instance.new("Frame")
        SliderFrame.Name = sliderName .. "_Slider"
        SliderFrame.Size = UDim2.new(1, 0, 0, 48)
        SliderFrame.BackgroundColor3 = Theme.InputBg
        SliderFrame.BorderSizePixel = 0
        SliderFrame.ZIndex = zIdx
        SliderFrame.Parent = parent

        local SliderCorner = Instance.new("UICorner")
        SliderCorner.CornerRadius = UDim.new(0, 6)
        SliderCorner.Parent = SliderFrame

        local SliderStroke = Instance.new("UIStroke")
        SliderStroke.Color = Theme.InputBorder
        SliderStroke.Thickness = 1
        SliderStroke.Parent = SliderFrame

        local Label = Instance.new("TextLabel")
        Label.Size = UDim2.new(1, -70, 0, 20)
        Label.Position = UDim2.new(0, 10, 0, 5)
        Label.BackgroundTransparency = 1
        Label.Text = sliderName
        Label.TextColor3 = Theme.TextBright
        Label.TextSize = 13
        Label.Font = Enum.Font.GothamMedium
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.ZIndex = zIdx + 1
        Label.Parent = SliderFrame

        -- Value TextBox (Custom editable input!)
        local ValueBox = Instance.new("TextBox")
        ValueBox.Size = UDim2.new(0, 50, 0, 20)
        ValueBox.Position = UDim2.new(1, -60, 0, 5)
        ValueBox.BackgroundColor3 = Theme.SectionBg
        ValueBox.Text = tostring(defaultVal)
        ValueBox.TextColor3 = Theme.Accent
        ValueBox.TextSize = 12
        ValueBox.Font = Enum.Font.GothamBold
        ValueBox.BorderSizePixel = 0
        ValueBox.ClearTextOnFocus = false
        ValueBox.ZIndex = zIdx + 2
        ValueBox.Parent = SliderFrame

        local BoxCorner = Instance.new("UICorner")
        BoxCorner.CornerRadius = UDim.new(0, 4)
        BoxCorner.Parent = ValueBox

        local BoxStroke = Instance.new("UIStroke")
        BoxStroke.Color = Theme.InputBorder
        BoxStroke.Thickness = 1
        BoxStroke.Parent = ValueBox

        local Track = Instance.new("Frame")
        Track.Name = "Track"
        Track.Size = UDim2.new(1, -20, 0, 6)
        Track.Position = UDim2.new(0, 10, 0, 32)
        Track.BackgroundColor3 = Theme.SectionBg
        Track.BorderSizePixel = 0
        Track.ZIndex = zIdx + 1
        Track.Parent = SliderFrame

        local TrackCorner = Instance.new("UICorner")
        TrackCorner.CornerRadius = UDim.new(1, 0)
        TrackCorner.Parent = Track

        local Fill = Instance.new("Frame")
        Fill.Name = "Fill"
        Fill.Size = UDim2.new((defaultVal - minVal) / (maxVal - minVal), 0, 1, 0)
        Fill.BackgroundColor3 = Theme.Accent
        Fill.BorderSizePixel = 0
        Fill.ZIndex = zIdx + 2
        Fill.Parent = Track

        local FillCorner = Instance.new("UICorner")
        FillCorner.CornerRadius = UDim.new(1, 0)
        FillCorner.Parent = Fill

        local Knob = Instance.new("Frame")
        Knob.Name = "Knob"
        Knob.Size = UDim2.new(0, 12, 0, 12)
        Knob.AnchorPoint = Vector2.new(0.5, 0.5)
        Knob.Position = UDim2.new(1, 0, 0.5, 0)
        Knob.BackgroundColor3 = Theme.TextBright
        Knob.BorderSizePixel = 0
        Knob.ZIndex = zIdx + 3
        Knob.Parent = Fill

        local KnobCorner = Instance.new("UICorner")
        KnobCorner.CornerRadius = UDim.new(1, 0)
        KnobCorner.Parent = Knob

        local currentValue = defaultVal

        local function SetValue(val, ignoreCallback)
            val = math.clamp(val, minVal, maxVal)
            if decimals == 0 then
                val = math.round(val)
            else
                local p = 10 ^ decimals
                val = math.round(val * p) / p
            end
            currentValue = val

            local alpha = (val - minVal) / (maxVal - minVal)
            Tween(Fill, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(alpha, 0, 1, 0)
            })
            ValueBox.Text = tostring(val)

            if not ignoreCallback then
                task.spawn(callback, val)
            end
        end

        ValueBox.FocusLost:Connect(function()
            local num = tonumber(ValueBox.Text)
            if num then
                SetValue(num)
            else
                ValueBox.Text = tostring(currentValue)
            end
        end)

        local draggingSlider = false

        local function UpdateFromInput(input)
            local trackAbsPos = Track.AbsolutePosition.X
            local trackAbsSize = Track.AbsoluteSize.X
            local mouseX = input.Position.X
            local alpha = math.clamp((mouseX - trackAbsPos) / trackAbsSize, 0, 1)
            local newRawVal = minVal + (maxVal - minVal) * alpha
            SetValue(newRawVal)
        end

        Track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                draggingSlider = true
                UpdateFromInput(input)
            end
        end)

        SliderFrame.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                local mouseY = input.Position.Y
                local trackY = Track.AbsolutePosition.Y
                if math.abs(mouseY - trackY) <= 15 then
                    draggingSlider = true
                    UpdateFromInput(input)
                end
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                draggingSlider = false
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                UpdateFromInput(input)
            end
        end)

        return {
            SetValue = SetValue,
            GetValue = function() return currentValue end
        }
    end

