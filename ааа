local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")

local VoltClips = {}
VoltClips.__index = VoltClips

-- Встроенные иконки по названию
local BuiltInIcons = {
    ["Legit"]    = "rbxassetid://118624373632520",
    ["HvH"]      = "rbxassetid://78242793290159",
    ["Visuals"]  = "rbxassetid://16475825226",
    ["World"]    = "rbxassetid://11887653877",
    ["Movement"] = "rbxassetid://136160678435000"
}

-- Стильная палитра Neverlose 2.0
local Theme = {
    Background = Color3.fromRGB(11, 13, 17),
    Sidebar    = Color3.fromRGB(15, 17, 23),
    Card       = Color3.fromRGB(18, 21, 28),
    CardStroke = Color3.fromRGB(35, 41, 55),
    Element    = Color3.fromRGB(13, 15, 20),
    Accent     = Color3.fromRGB(85, 115, 255),
    Text       = Color3.fromRGB(240, 243, 250),
    SubText    = Color3.fromRGB(110, 118, 135)
}

local function CreateCorner(parent, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 6)
    corner.Parent = parent
    return corner
end

local function CreateStroke(parent, color, thickness, transparency)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color or Theme.CardStroke
    stroke.Thickness = thickness or 1
    stroke.Transparency = transparency or 0.3
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = parent
    return stroke
end

function VoltClips:CreateWindow(hubTitle)
    local Window = {}
    
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "VoltClips_Framework"
    ScreenGui.ResetOnSpawn = false
    
    pcall(function() ScreenGui.Parent = CoreGui end)
    if not ScreenGui.Parent then
        ScreenGui.Parent = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
    end

    -- Компактное главное окно (620x390)
    local Main = Instance.new("Frame")
    Main.Name = "MainFrame"
    Main.Size = UDim2.new(0, 620, 0, 390)
    Main.Position = UDim2.new(0.5, -310, 0.5, -195)
    Main.BackgroundColor3 = Theme.Background
    Main.BackgroundTransparency = 0.05
    Main.BorderSizePixel = 0
    Main.ClipsDescendants = false
    Main.Parent = ScreenGui

    CreateCorner(Main, 10)
    CreateStroke(Main, Theme.CardStroke, 1, 0.1)

    -- Система перетаскивания
    local dragging, dragStart, startPos
    Main.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = Main.Position
        end
    end)
    Main.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    -- Левый Сайдбар
    local Sidebar = Instance.new("Frame")
    Sidebar.Name = "Sidebar"
    Sidebar.Size = UDim2.new(0, 52, 1, 0)
    Sidebar.BackgroundColor3 = Theme.Sidebar
    Sidebar.BackgroundTransparency = 0.1
    Sidebar.BorderSizePixel = 0
    Sidebar.Parent = Main
    CreateCorner(Sidebar, 10)

    -- Текст-логотип VC
    local Logo = Instance.new("TextLabel")
    Logo.Size = UDim2.new(1, 0, 0, 42)
    Logo.BackgroundTransparency = 1
    Logo.Text = "VC"
    Logo.TextColor3 = Theme.Accent
    Logo.TextSize = 18
    Logo.Font = Enum.Font.GothamBold
    Logo.Parent = Sidebar

    local TabList = Instance.new("Frame")
    TabList.Size = UDim2.new(1, 0, 1, -50)
    TabList.Position = UDim2.new(0, 0, 0, 45)
    TabList.BackgroundTransparency = 1
    TabList.Parent = Sidebar

    local TabListLayout = Instance.new("UIListLayout")
    TabListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    TabListLayout.Padding = UDim.new(0, 8)
    TabListLayout.Parent = TabList

    -- Верхняя панель подвкладок
    local TopBar = Instance.new("Frame")
    TopBar.Name = "TopBar"
    TopBar.Size = UDim2.new(1, -60, 0, 35)
    TopBar.Position = UDim2.new(0, 60, 0, 5)
    TopBar.BackgroundTransparency = 1
    TopBar.Parent = Main

    local SubTabContainer = Instance.new("Frame")
    SubTabContainer.Size = UDim2.new(1, 0, 1, 0)
    SubTabContainer.BackgroundTransparency = 1
    SubTabContainer.Parent = TopBar

    local SubTabLayout = Instance.new("UIListLayout")
    SubTabLayout.FillDirection = Enum.FillDirection.Horizontal
    SubTabLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    SubTabLayout.Padding = UDim.new(0, 6)
    SubTabLayout.Parent = SubTabContainer

    -- Основная Рабочая Зона
    local ContentContainer = Instance.new("Frame")
    ContentContainer.Name = "ContentContainer"
    ContentContainer.Size = UDim2.new(1, -65, 1, -45)
    ContentContainer.Position = UDim2.new(0, 58, 0, 40)
    ContentContainer.BackgroundTransparency = 1
    ContentContainer.Parent = Main

    local Tabs = {}
    local PiecesToBreak = {}

    -- Вкладки слева (С ВСТРОЕННЫМИ ИКОНКАМИ)
    function Window:AddTab(tabName)
        local Tab = { SubTabs = {} }

        -- Определение иконки из встроенной таблицы
        local imageUri = BuiltInIcons[tabName]
        if not imageUri then
            local cleanId = tostring(tabName):gsub("%D", "")
            if #cleanId > 0 then
                imageUri = "rbxassetid://" .. cleanId
            else
                imageUri = ""
            end
        end

        local TabBtn = Instance.new("ImageButton")
        TabBtn.Size = UDim2.new(0, 34, 0, 34)
        TabBtn.BackgroundColor3 = Theme.Element
        TabBtn.BackgroundTransparency = 0.5
        TabBtn.Image = imageUri
        TabBtn.ImageColor3 = Theme.SubText
        TabBtn.ScaleType = Enum.ScaleType.Fit
        TabBtn.AutoButtonColor = false
        TabBtn.Parent = TabList
        CreateCorner(TabBtn, 8)
        CreateStroke(TabBtn, Theme.CardStroke, 1, 0.6)

        Tab.Button = TabBtn

        -- Подвкладки сверху
        function Tab:AddSubTab(subName)
            local SubTab = {}

            local SubBtn = Instance.new("TextButton")
            SubBtn.Size = UDim2.new(0, 70, 0, 24)
            SubBtn.BackgroundColor3 = Theme.Card
            SubBtn.BackgroundTransparency = 0.3
            SubBtn.Text = subName
            SubBtn.TextColor3 = Theme.SubText
            SubBtn.Font = Enum.Font.GothamMedium
            SubBtn.TextSize = 11
            SubBtn.Visible = false
            SubBtn.Parent = SubTabContainer
            CreateCorner(SubBtn, 6)

            -- Страница с 2 колонками
            local Page = Instance.new("Frame")
            Page.Size = UDim2.new(1, -5, 1, 0)
            Page.BackgroundTransparency = 1
            Page.Visible = false
            Page.Parent = ContentContainer

            -- Скроллируемые колонки
            local LeftCol = Instance.new("ScrollingFrame")
            LeftCol.Size = UDim2.new(0.49, -2, 1, 0)
            LeftCol.BackgroundTransparency = 1
            LeftCol.ScrollBarThickness = 2
            LeftCol.ScrollBarImageColor3 = Theme.Accent
            LeftCol.ScrollBarImageTransparency = 0.5
            LeftCol.BorderSizePixel = 0
            LeftCol.AutomaticCanvasSize = Enum.AutomaticSize.Y
            LeftCol.CanvasSize = UDim2.new(0, 0, 0, 0)
            LeftCol.Parent = Page

            local RightCol = Instance.new("ScrollingFrame")
            RightCol.Size = UDim2.new(0.49, -2, 1, 0)
            RightCol.Position = UDim2.new(0.51, 0, 0, 0)
            RightCol.BackgroundTransparency = 1
            RightCol.ScrollBarThickness = 2
            RightCol.ScrollBarImageColor3 = Theme.Accent
            RightCol.ScrollBarImageTransparency = 0.5
            RightCol.BorderSizePixel = 0
            RightCol.AutomaticCanvasSize = Enum.AutomaticSize.Y
            RightCol.CanvasSize = UDim2.new(0, 0, 0, 0)
            RightCol.Parent = Page

            local LList = Instance.new("UIListLayout")
            LList.Padding = UDim.new(0, 8)
            LList.Parent = LeftCol

            local RList = Instance.new("UIListLayout")
            RList.Padding = UDim.new(0, 8)
            RList.Parent = RightCol

            local LPadd = Instance.new("UIPadding")
            LPadd.PaddingRight = UDim.new(0, 4)
            LPadd.Parent = LeftCol

            local RPadd = Instance.new("UIPadding")
            RPadd.PaddingRight = UDim.new(0, 4)
            RPadd.Parent = RightCol

            SubTab.Button = SubBtn
            SubTab.Page = Page

            -- Секции (Карточки)
            function SubTab:AddSection(secTitle, side)
                local Section = {}
                local TargetCol = (side == "right") and RightCol or LeftCol

                local Card = Instance.new("Frame")
                Card.Name = "CardSection"
                Card.Size = UDim2.new(1, 0, 0, 35)
                Card.BackgroundColor3 = Theme.Card
                Card.BackgroundTransparency = 0.2
                Card.Parent = TargetCol
                CreateCorner(Card, 8)
                CreateStroke(Card, Theme.CardStroke, 1, 0.3)

                table.insert(PiecesToBreak, Card)

                local TitleLabel = Instance.new("TextLabel")
                TitleLabel.Size = UDim2.new(1, -16, 0, 22)
                TitleLabel.Position = UDim2.new(0, 10, 0, 4)
                TitleLabel.BackgroundTransparency = 1
                TitleLabel.Text = secTitle
                TitleLabel.TextColor3 = Theme.Text
                TitleLabel.Font = Enum.Font.GothamBold
                TitleLabel.TextSize = 11
                TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
                TitleLabel.Parent = Card

                local Container = Instance.new("Frame")
                Container.Size = UDim2.new(1, -20, 1, -28)
                Container.Position = UDim2.new(0, 10, 0, 26)
                Container.BackgroundTransparency = 1
                Container.Parent = Card

                local CList = Instance.new("UIListLayout")
                CList.Padding = UDim.new(0, 6)
                CList.Parent = Container

                CList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                    Card.Size = UDim2.new(1, 0, 0, CList.AbsoluteContentSize.Y + 32)
                end)

                -- 1. КНОПКА
                function Section:AddButton(text, callback)
                    local Btn = Instance.new("TextButton")
                    Btn.Size = UDim2.new(1, 0, 0, 24)
                    Btn.BackgroundColor3 = Theme.Element
                    Btn.Text = text
                    Btn.TextColor3 = Theme.Text
                    Btn.Font = Enum.Font.GothamMedium
                    Btn.TextSize = 11
                    Btn.Parent = Container
                    CreateCorner(Btn, 6)
                    CreateStroke(Btn, Theme.CardStroke, 1, 0.4)

                    Btn.MouseButton1Click:Connect(function()
                        TweenService:Create(Btn, TweenInfo.new(0.1), {BackgroundColor3 = Theme.Accent}):Play()
                        task.wait(0.1)
                        TweenService:Create(Btn, TweenInfo.new(0.1), {BackgroundColor3 = Theme.Element}):Play()
                        if callback then callback() end
                    end)
                end

                -- 2. ГАЛОЧКА (Toggle)
                function Section:AddToggle(text, default, callback)
                    local active = default or false

                    local TFrame = Instance.new("Frame")
                    TFrame.Size = UDim2.new(1, 0, 0, 20)
                    TFrame.BackgroundTransparency = 1
                    TFrame.Parent = Container

                    local Box = Instance.new("TextButton")
                    Box.Size = UDim2.new(0, 16, 0, 16)
                    Box.Position = UDim2.new(0, 0, 0.5, -8)
                    Box.BackgroundColor3 = active and Theme.Accent or Theme.Element
                    Box.Text = ""
                    Box.Parent = TFrame
                    CreateCorner(Box, 4)
                    CreateStroke(Box, Theme.CardStroke, 1, 0.4)

                    local Label = Instance.new("TextLabel")
                    Label.Size = UDim2.new(1, -24, 1, 0)
                    Label.Position = UDim2.new(0, 22, 0, 0)
                    Label.BackgroundTransparency = 1
                    Label.Text = text
                    Label.TextColor3 = active and Theme.Text or Theme.SubText
                    Label.Font = Enum.Font.Gotham
                    Label.TextSize = 11
                    Label.TextXAlignment = Enum.TextXAlignment.Left
                    Label.Parent = TFrame

                    Box.MouseButton1Click:Connect(function()
                        active = not active
                        TweenService:Create(Box, TweenInfo.new(0.15), {BackgroundColor3 = active and Theme.Accent or Theme.Element}):Play()
                        TweenService:Create(Label, TweenInfo.new(0.15), {TextColor3 = active and Theme.Text or Theme.SubText}):Play()
                        if callback then callback(active) end
                    end)
                end

                -- 3. СЛАЙДЕР
                function Section:AddSlider(text, min, max, default, callback)
                    local val = default or min

                    local SFrame = Instance.new("Frame")
                    SFrame.Size = UDim2.new(1, 0, 0, 30)
                    SFrame.BackgroundTransparency = 1
                    SFrame.Parent = Container

                    local Title = Instance.new("TextLabel")
                    Title.Size = UDim2.new(1, 0, 0, 13)
                    Title.BackgroundTransparency = 1
                    Title.Text = text
                    Title.TextColor3 = Theme.SubText
                    Title.Font = Enum.Font.Gotham
                    Title.TextSize = 11
                    Title.TextXAlignment = Enum.TextXAlignment.Left
                    Title.Parent = SFrame

                    local ValLbl = Instance.new("TextLabel")
                    ValLbl.Size = UDim2.new(1, 0, 0, 13)
                    ValLbl.BackgroundTransparency = 1
                    ValLbl.Text = tostring(val)
                    ValLbl.TextColor3 = Theme.Text
                    ValLbl.Font = Enum.Font.Gotham
                    ValLbl.TextSize = 11
                    ValLbl.TextXAlignment = Enum.TextXAlignment.Right
                    ValLbl.Parent = SFrame

                    local Bar = Instance.new("Frame")
                    Bar.Size = UDim2.new(1, 0, 0, 4)
                    Bar.Position = UDim2.new(0, 0, 0, 18)
                    Bar.BackgroundColor3 = Theme.Element
                    Bar.Parent = SFrame
                    CreateCorner(Bar, 2)

                    local Fill = Instance.new("Frame")
                    Fill.Size = UDim2.new((val - min)/(max - min), 0, 1, 0)
                    Fill.BackgroundColor3 = Theme.Accent
                    Fill.Parent = Bar
                    CreateCorner(Fill, 2)

                    local sliding = false
                    local function update(input)
                        local pos = math.clamp((input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
                        val = math.floor(min + ((max - min) * pos))
                        ValLbl.Text = tostring(val)
                        Fill.Size = UDim2.new(pos, 0, 1, 0)
                        if callback then callback(val) end
                    end

                    Bar.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then sliding = true update(input) end
                    end)
                    UserInputService.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end
                    end)
                    UserInputService.InputChanged:Connect(function(input)
                        if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then update(input) end
                    end)
                end

                -- 4. ТЕКСТБОКС
                function Section:AddTextBox(text, placeholder, callback)
                    local TBoxFrame = Instance.new("Frame")
                    TBoxFrame.Size = UDim2.new(1, 0, 0, 24)
                    TBoxFrame.BackgroundColor3 = Theme.Element
                    TBoxFrame.Parent = Container
                    CreateCorner(TBoxFrame, 6)
                    CreateStroke(TBoxFrame, Theme.CardStroke, 1, 0.4)

                    local Input = Instance.new("TextBox")
                    Input.Size = UDim2.new(1, -10, 1, 0)
                    Input.Position = UDim2.new(0, 5, 0, 0)
                    Input.BackgroundTransparency = 1
                    Input.Text = ""
                    Input.PlaceholderText = placeholder or text
                    Input.PlaceholderColor3 = Theme.SubText
                    Input.TextColor3 = Theme.Text
                    Input.Font = Enum.Font.Gotham
                    Input.TextSize = 11
                    Input.TextXAlignment = Enum.TextXAlignment.Left
                    Input.Parent = TBoxFrame

                    Input.FocusLost:Connect(function()
                        if callback then callback(Input.Text) end
                    end)
                end

                return Section
            end

            -- Переключение Подвкладки
            SubBtn.MouseButton1Click:Connect(function()
                for _, st in pairs(Tab.SubTabs) do
                    st.Button.TextColor3 = Theme.SubText
                    st.Button.BackgroundColor3 = Theme.Card
                    st.Page.Visible = false
                end
                SubBtn.TextColor3 = Theme.Accent
                SubBtn.BackgroundColor3 = Theme.Sidebar
                Page.Visible = true
            end)

            table.insert(Tab.SubTabs, SubTab)
            if #Tab.SubTabs == 1 then
                SubBtn.TextColor3 = Theme.Accent
                SubBtn.BackgroundColor3 = Theme.Sidebar
                Page.Visible = true
            end

            return SubTab
        end

        -- Переключение Главной Вкладки
        TabBtn.MouseButton1Click:Connect(function()
            for _, t in pairs(Tabs) do
                t.Button.ImageColor3 = Theme.SubText
                t.Button.BackgroundTransparency = 0.5
                for _, st in pairs(t.SubTabs) do
                    st.Button.Visible = false
                    st.Page.Visible = false
                end
            end
            TabBtn.ImageColor3 = Theme.Accent
            TabBtn.BackgroundTransparency = 0.2

            for _, st in pairs(Tab.SubTabs) do
                st.Button.Visible = true
            end
            if #Tab.SubTabs > 0 then
                Tab.SubTabs[1].Page.Visible = true
                Tab.SubTabs[1].Button.TextColor3 = Theme.Accent
            end
        end)

        table.insert(Tabs, Tab)
        if #Tabs == 1 then
            TabBtn.ImageColor3 = Theme.Accent
            TabBtn.BackgroundTransparency = 0.2
        end

        return Tab
    end

    -- Анимация Разрушения на Right Shift
    local isOpen = true
    local animating = false

    local function ToggleMenu()
        if animating then return end
        animating = true

        if isOpen then
            for _, card in pairs(PiecesToBreak) do
                local rx = math.random(-250, 250)
                local ry = math.random(-250, 250)
                local rRot = math.random(-60, 60)

                TweenService:Create(card, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
                    Position = card.Position + UDim2.new(0, rx, 0, ry),
                    Rotation = rRot,
                    BackgroundTransparency = 1
                }):Play()
            end

            TweenService:Create(Main, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                BackgroundTransparency = 1
            }):Play()

            task.wait(0.35)
            Main.Visible = false
            isOpen = false
        else
            Main.Visible = true
            TweenService:Create(Main, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                BackgroundTransparency = 0.05
            }):Play()

            for _, card in pairs(PiecesToBreak) do
                TweenService:Create(card, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                    Position = UDim2.new(0, 0, card.Position.Y.Scale, card.Position.Y.Offset),
                    Rotation = 0,
                    BackgroundTransparency = 0.2
                }):Play()
            end

            task.wait(0.4)
            isOpen = true
        end

        animating = false
    end

    UserInputService.InputBegan:Connect(function(input, gpe)
        if not gpe and input.KeyCode == Enum.KeyCode.RightShift then
            ToggleMenu()
        end
    end)

    return Window
end

return VoltClips
