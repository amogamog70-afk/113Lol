        ValueBox.Position = UDim2.new(1, -56, 0, 5)
        ValueBox.BackgroundColor3 = Theme.SectionBg
        ValueBox.Text = tostring(defaultVal)
        ValueBox.TextColor3 = Theme.Accent
        ValueBox.TextSize = 11
        ValueBox.Font = Enum.Font.GothamBold
        ValueBox.BorderSizePixel = 0
        ValueBox.ClearTextOnFocus = false
        ValueBox.ZIndex = zIdx + 2
        ValueBox.Parent = SliderFrame

        local BoxCorner = Instance.new("UICorner")
        BoxCorner.CornerRadius = UDim.new(0, 4)
        BoxCorner.Parent = ValueBox

        local BoxStroke = Instance.new("UIStroke")
        BoxStroke.Color = Theme.InputBorder
        BoxStroke.Thickness = 1
        BoxStroke.Parent = ValueBox

        local Track = Instance.new("Frame")
