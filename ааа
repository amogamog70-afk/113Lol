local function RandomString(len)
    local chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    local length = len or math.random(10, 16)
    local result = {}
    for i = 1, length do
        local randIndex = math.random(1, #chars)
        result[i] = string.sub(chars, randIndex, randIndex)
    end
    return table.concat(result)
end

-- Авто-очистка логов каждые 60 секунд
task.spawn(function()
    while task.wait(60) do
        pcall(function() LogService:ClearOutput() end)
        pcall(function() collectgarbage("collect") end)
    end
end)

local function GetSafeContainer()
    if gethui then
        local holder = gethui()
        local sg = Instance.new("ScreenGui")
        sg.Name = RandomString(14)
        sg.ResetOnSpawn = false
        sg.Parent = holder
        return sg
    end

    local sg = Instance.new("ScreenGui")
    sg.Name = RandomString(14)
    sg.ResetOnSpawn = false

    if syn and syn.protect_gui then
        pcall(function() syn.protect_gui(sg) end)
        pcall(function() sg.Parent = CoreGui end)
    elseif protectgui then
        pcall(function() protectgui(sg) end)
        pcall(function() sg.Parent = CoreGui end)
    else
        local success = pcall(function() sg.Parent = CoreGui end)
        if not success or not sg.Parent then
            sg.Parent = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
        end
    end
    return sg
end

