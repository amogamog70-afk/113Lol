    -- Internal Slider Helper
    function WindowObj:InternalCreateSlider(parent, opts, customZIndex)
        opts = opts or {}
        local sliderName = opts.Name or "Slider"
        local minVal = opts.Min or 0
        local maxVal = opts.Max or 100
        local defaultVal = math.clamp(opts.Default or minVal, minVal, maxVal)
