        local SwitchBg = Instance.new("TextButton")
        SwitchBg.Size = UDim2.new(0, 38, 0, 20)
        SwitchBg.Position = UDim2.new(1, hasSettings and -72 or -48, 0.5, -10)
        SwitchBg.BackgroundColor3 = defaultState and Theme.Accent or Theme.ToggleOff
        SwitchBg.BorderSizePixel = 0
        SwitchBg.Text = ""
        SwitchBg.AutoButtonColor = false
        SwitchBg.ZIndex = zIdx + 1
        SwitchBg.Parent = ToggleFrame

        local SwitchCorner = Instance.new("UICorner")
        SwitchCorner.CornerRadius = UDim.new(1, 0)
        SwitchCorner.Parent = SwitchBg

        local SwitchDot = Instance.new("Frame")
        SwitchDot.Size = UDim2.new(0, 14, 0, 14)
        SwitchDot.Position = defaultState and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
        SwitchDot.BackgroundColor3 = Theme.TextBright
        SwitchDot.BorderSizePixel = 0
        SwitchDot.ZIndex = zIdx + 2
        SwitchDot.Parent = SwitchBg

        local DotCorner = Instance.new("UICorner")
        DotCorner.CornerRadius = UDim.new(1, 0)
        DotCorner.Parent = SwitchDot

        local gearBtn
        if hasSettings then
            gearBtn = Instance.new("ImageButton")
            gearBtn.Size = UDim2.new(0, 22, 0, 22)
            gearBtn.Position = UDim2.new(1, -30, 0.5, -11)
            gearBtn.BackgroundTransparency = 1
            gearBtn.Image = gearIconId
            gearBtn.ImageColor3 = Theme.TextMuted
            gearBtn.ZIndex = zIdx + 2
            gearBtn.Parent = ToggleFrame

            gearBtn.MouseEnter:Connect(function()
                Tween(gearBtn, TweenInfo.new(0.15), {ImageColor3 = Theme.Accent})
            end)
            gearBtn.MouseLeave:Connect(function()
                Tween(gearBtn, TweenInfo.new(0.15), {ImageColor3 = Theme.TextMuted})
            end)

            gearBtn.MouseButton1Click:Connect(function()
                OpenModal(toggleName .. " Settings", buildSettings)
            end)
        end

        local currentState = defaultState

        local function SetState(state, ignoreCallback)
            currentState = state
            local targetBg = currentState and Theme.Accent or Theme.ToggleOff
            local targetPos = currentState and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)

            Tween(SwitchBg, TweenInfo.new(0.18), {BackgroundColor3 = targetBg})
            Tween(SwitchDot, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = targetPos})

            if not ignoreCallback then
                task.spawn(callback, currentState)
            end
        end

        SwitchBg.MouseButton1Click:Connect(function()
            local newState = not currentState
            SetState(newState)

            -- If enabled and has settings, open modal popup settings window
            if newState and hasSettings and buildSettings then
                OpenModal(toggleName .. " Settings", buildSettings)
            end
        end)

        return {
            SetState = SetState,
            GetState = function() return currentState end
        }
    end

    -- Create Tab Method
    function WindowObj:CreateTab(tabName, iconId)
        tabName = tabName or "Tab"

        local TabBtn = Instance.new("TextButton")
        TabBtn.Name = tabName .. "_TabBtn"
        TabBtn.Size = UDim2.new(1, 0, 0, 34)
        TabBtn.BackgroundColor3 = Theme.MainBg
        TabBtn.BackgroundTransparency = 1
        TabBtn.BorderSizePixel = 0
        TabBtn.Text = ""
        TabBtn.AutoButtonColor = false
        TabBtn.Parent = TabHolder

        local TabBtnCorner = Instance.new("UICorner")
        TabBtnCorner.CornerRadius = UDim.new(0, 6)
        TabBtnCorner.Parent = TabBtn

        local ActiveIndicator = Instance.new("Frame")
        ActiveIndicator.Size = UDim2.new(0, 3, 0, 18)
        ActiveIndicator.Position = UDim2.new(0, 0, 0.5, -9)
        ActiveIndicator.BackgroundColor3 = Theme.Accent
        ActiveIndicator.BorderSizePixel = 0
        ActiveIndicator.BackgroundTransparency = 1
        ActiveIndicator.Parent = TabBtn

        local IndicatorCorner = Instance.new("UICorner")
        IndicatorCorner.CornerRadius = UDim.new(1, 0)
        IndicatorCorner.Parent = ActiveIndicator

        local TextOffset = 12
        if iconId then
            TextOffset = 34
            local Icon = Instance.new("ImageLabel")
            Icon.Size = UDim2.new(0, 16, 0, 16)
            Icon.Position = UDim2.new(0, 10, 0.5, -8)
            Icon.BackgroundTransparency = 1
            Icon.Image = iconId
            Icon.ImageColor3 = Theme.TextMuted
            Icon.Parent = TabBtn
        end

        local TabLabel = Instance.new("TextLabel")
        TabLabel.Size = UDim2.new(1, -TextOffset, 1, 0)
        TabLabel.Position = UDim2.new(0, TextOffset, 0, 0)
        TabLabel.BackgroundTransparency = 1
        TabLabel.Text = tabName
        TabLabel.TextColor3 = Theme.TextMuted
        TabLabel.TextSize = 13
        TabLabel.Font = Enum.Font.GothamMedium
        TabLabel.TextXAlignment = Enum.TextXAlignment.Left
        TabLabel.Parent = TabBtn

        local PageFrame = Instance.new("ScrollingFrame")
        PageFrame.Name = tabName .. "_Page"
        PageFrame.Size = UDim2.new(1, -20, 1, -20)
        PageFrame.Position = UDim2.new(0, 10, 0, 10)
        PageFrame.BackgroundTransparency = 1
        PageFrame.BorderSizePixel = 0
        PageFrame.ScrollBarThickness = 3
        PageFrame.ScrollBarImageColor3 = Theme.Accent
        PageFrame.Visible = false
        PageFrame.Parent = ContentArea

        local PageLayout = Instance.new("UIListLayout")
        PageLayout.SortOrder = Enum.SortOrder.LayoutOrder
        PageLayout.Padding = UDim.new(0, 12)
        PageLayout.Parent = PageFrame

        PageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            PageFrame.CanvasSize = UDim2.new(0, 0, 0, PageLayout.AbsoluteContentSize.Y + 15)
        end)

        local TabObj = {
            Name = tabName,
            Button = TabBtn,
            Page = PageFrame
        }

        local function ActivateTab()
            for _, t in ipairs(WindowObj.Tabs) do
                t.Page.Visible = false
                Tween(t.Button, TweenInfo.new(0.15), {BackgroundTransparency = 1})
                local ind = t.Button:FindFirstChild("Frame")
                if ind then
                    Tween(ind, TweenInfo.new(0.15), {BackgroundTransparency = 1})
                end
                local lbl = t.Button:FindFirstChildOfClass("TextLabel")
                if lbl then
                    Tween(lbl, TweenInfo.new(0.15), {TextColor3 = Theme.TextMuted})
                end
            end

            PageFrame.Visible = true
            WindowObj.ActiveTab = TabObj
            Tween(TabBtn, TweenInfo.new(0.15), {BackgroundTransparency = 0.8, BackgroundColor3 = Theme.Accent})
            Tween(ActiveIndicator, TweenInfo.new(0.15), {BackgroundTransparency = 0})
            Tween(TabLabel, TweenInfo.new(0.15), {TextColor3 = Theme.TextBright})
        end

        TabBtn.MouseButton1Click:Connect(ActivateTab)

        if #WindowObj.Tabs == 0 then
            ActivateTab()
        end

        table.insert(WindowObj.Tabs, TabObj)

        function TabObj:CreateSection(sectionName)
            sectionName = sectionName or "Section"

            local SectionFrame = Instance.new("Frame")
            SectionFrame.Name = sectionName .. "_Section"
            SectionFrame.Size = UDim2.new(1, 0, 0, 36)
            SectionFrame.BackgroundColor3 = Theme.SectionBg
            SectionFrame.BorderSizePixel = 0
            SectionFrame.Parent = PageFrame

            local SectionCorner = Instance.new("UICorner")
            SectionCorner.CornerRadius = UDim.new(0, 8)
            SectionCorner.Parent = SectionFrame

            local SectionStroke = Instance.new("UIStroke")
            SectionStroke.Color = Theme.CardBorder
            SectionStroke.Thickness = 1
            SectionStroke.Parent = SectionFrame

            local SecTitle = Instance.new("TextLabel")
            SecTitle.Size = UDim2.new(1, -20, 0, 28)
            SecTitle.Position = UDim2.new(0, 10, 0, 4)
            SecTitle.BackgroundTransparency = 1
            SecTitle.Text = string.upper(sectionName)
            SecTitle.TextColor3 = Theme.Accent
            SecTitle.TextSize = 11
            SecTitle.Font = Enum.Font.GothamBold
            SecTitle.TextXAlignment = Enum.TextXAlignment.Left
            SecTitle.Parent = SectionFrame

            local Line = Instance.new("Frame")
            Line.Size = UDim2.new(1, -20, 0, 1)
            Line.Position = UDim2.new(0, 10, 0, 32)
            Line.BackgroundColor3 = Theme.CardBorder
            Line.BorderSizePixel = 0
            Line.Parent = SectionFrame

            local Container = Instance.new("Frame")
            Container.Size = UDim2.new(1, -20, 0, 0)
            Container.Position = UDim2.new(0, 10, 0, 38)
            Container.BackgroundTransparency = 1
            Container.Parent = SectionFrame

            local ContainerLayout = Instance.new("UIListLayout")
            ContainerLayout.SortOrder = Enum.SortOrder.LayoutOrder
            ContainerLayout.Padding = UDim.new(0, 8)
            ContainerLayout.Parent = Container

            ContainerLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                Container.Size = UDim2.new(1, -20, 0, ContainerLayout.AbsoluteContentSize.Y)
                SectionFrame.Size = UDim2.new(1, 0, 0, ContainerLayout.AbsoluteContentSize.Y + 46)
            end)

            local SectionObj = {}

            function SectionObj:CreateToggle(toggleOpts)
                return WindowObj:InternalCreateToggle(Container, toggleOpts, 1)
            end

            function SectionObj:CreateSlider(sliderOpts)
                return WindowObj:InternalCreateSlider(Container, sliderOpts, 1)
            end

            function SectionObj:CreateButton(opts)
                opts = opts or {}
                local btnText = opts.Name or "Button"
                local callback = opts.Callback or function() end

                local BtnFrame = Instance.new("TextButton")
                BtnFrame.Name = btnText .. "_Button"
                BtnFrame.Size = UDim2.new(1, 0, 0, 34)
                BtnFrame.BackgroundColor3 = Theme.InputBg
                BtnFrame.BorderSizePixel = 0
                BtnFrame.Text = btnText
                BtnFrame.TextColor3 = Theme.TextBright
                BtnFrame.TextSize = 13
                BtnFrame.Font = Enum.Font.GothamMedium
                BtnFrame.AutoButtonColor = false
                BtnFrame.Parent = Container

                local BtnCorner = Instance.new("UICorner")
                BtnCorner.CornerRadius = UDim.new(0, 6)
                BtnCorner.Parent = BtnFrame

                local BtnStroke = Instance.new("UIStroke")
                BtnStroke.Color = Theme.InputBorder
                BtnStroke.Thickness = 1
                BtnStroke.Parent = BtnFrame

                BtnFrame.MouseEnter:Connect(function()
                    Tween(BtnFrame, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Accent, TextColor3 = Color3.fromRGB(255, 255, 255)})
                end)
                BtnFrame.MouseLeave:Connect(function()
                    Tween(BtnFrame, TweenInfo.new(0.15), {BackgroundColor3 = Theme.InputBg, TextColor3 = Theme.TextBright})
                end)

                BtnFrame.MouseButton1Click:Connect(function()
                    task.spawn(callback)
                end)

                return BtnFrame
            end

            return SectionObj
        end

        return TabObj
    end

    return WindowObj
end

return VoltClips

