                    local function setToggle(state)
                        active = state
                        TweenService:Create(SwitchBg, TweenInfo.new(0.16), {BackgroundColor3 = active and Theme.Accent or Theme.Element}):Play()
                        TweenService:Create(Label, TweenInfo.new(0.16), {TextColor3 = active and Theme.Text or Theme.SubText}):Play()
                        TweenService:Create(Knob, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                            Position = active and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)
                        }):Play()
                        if callback then pcall(callback, active) end
                    end

                    SwitchBg.MouseButton1Click:Connect(function()
                        setToggle(not active)
                    end)

                    TFrame.MouseEnter:Connect(function()
                        TweenService:Create(TFrame, TweenInfo.new(0.1), {BackgroundTransparency = 0.8}):Play()
                    end)
                    TFrame.MouseLeave:Connect(function()
                        TweenService:Create(TFrame, TweenInfo.new(0.1), {BackgroundTransparency = 1}):Play()
                    end)

                    -- Всплывающее окно под-настроек (•••)
                    if optionsTable and type(optionsTable) == "table" and #optionsTable > 0 then
                        local DotsBtn = Instance.new("TextButton")
                        DotsBtn.Name = RandomString(6)
                        DotsBtn.Size = UDim2.new(0, 18, 0, 14)
                        DotsBtn.Position = UDim2.new(1, -52, 0.5, -7)
                        DotsBtn.BackgroundColor3 = Theme.Element
                        DotsBtn.Text = "•••"
                        DotsBtn.TextColor3 = Theme.SubText
                        DotsBtn.Font = Enum.Font.GothamBold
                        DotsBtn.TextSize = 8
                        DotsBtn.AutoButtonColor = false
                        DotsBtn.Parent = TFrame
                        CreateCorner(DotsBtn, 3)

                        DotsBtn.MouseButton1Click:Connect(function()
                            CloseAllPopups()

                            local popDragging = false
                            local ClickCatcher = Instance.new("TextButton")
                            ClickCatcher.Name = RandomString(8) .. "_block"
                            ClickCatcher.Size = UDim2.new(1, 0, 1, 0)
                            ClickCatcher.BackgroundTransparency = 1
                            ClickCatcher.Text = ""
                            ClickCatcher.AutoButtonColor = false
                            ClickCatcher.ZIndex = 900
                            ClickCatcher.Parent = ScreenGui

                            local Popup = Instance.new("Frame")
                            Popup.Name = RandomString(10)
                            Popup.BackgroundColor3 = Theme.Card
                            Popup.ZIndex = 901
                            Popup.Parent = OverlayFolder
                            CreateCorner(Popup, 6)
                            CreateStroke(Popup, Theme.CardStroke, 1, 0.4)

                            local btnAbsPos = DotsBtn.AbsolutePosition
                            local screenSize = workspace.CurrentCamera.ViewportSize
                            local popupW = 185
                            local posX = math.min(btnAbsPos.X + 22, screenSize.X - popupW - 10)
                            local posY = math.clamp(btnAbsPos.Y - 6, 10, screenSize.Y - 250)
                            Popup.Position = UDim2.new(0, posX, 0, posY)

                            local PopHeader = Instance.new("Frame")
                            PopHeader.Size = UDim2.new(1, 0, 0, 26)
                            PopHeader.BackgroundColor3 = Theme.Sidebar
                            PopHeader.BorderSizePixel = 0
                            PopHeader.ZIndex = 902
                            PopHeader.Parent = Popup
                            CreateCorner(PopHeader, 6)

                            local PopHeaderPatch = Instance.new("Frame")
                            PopHeaderPatch.Size = UDim2.new(1, 0, 0, 6)
                            PopHeaderPatch.Position = UDim2.new(0, 0, 1, -6)
                            PopHeaderPatch.BackgroundColor3 = Theme.Sidebar
                            PopHeaderPatch.BorderSizePixel = 0
                            PopHeaderPatch.ZIndex = 902
                            PopHeaderPatch.Parent = PopHeader

                            local PopHeaderTitle = Instance.new("TextLabel")
                            PopHeaderTitle.Size = UDim2.new(1, -30, 1, 0)
                            PopHeaderTitle.Position = UDim2.new(0, 8, 0, 0)
                            PopHeaderTitle.BackgroundTransparency = 1
                            PopHeaderTitle.Text = text .. " Options"
                            PopHeaderTitle.TextColor3 = Theme.Text
                            PopHeaderTitle.Font = Enum.Font.GothamBold
                            PopHeaderTitle.TextSize = 10
                            PopHeaderTitle.TextXAlignment = Enum.TextXAlignment.Left
                            PopHeaderTitle.ZIndex = 903
                            PopHeaderTitle.Parent = PopHeader

                            local PopClose = Instance.new("TextButton")
                            PopClose.Size = UDim2.new(0, 18, 0, 18)
                            PopClose.Position = UDim2.new(1, -20, 0.5, -9)
                            PopClose.BackgroundTransparency = 1
                            PopClose.Text = "✕"
                            PopClose.TextColor3 = Theme.SubText
                            PopClose.Font = Enum.Font.GothamBold
                            PopClose.TextSize = 9
                            PopClose.ZIndex = 903
                            PopClose.Parent = PopHeader

                            PopClose.MouseButton1Click:Connect(function()
                                CloseAllPopups()
                            end)

                            local pDragStart, pStartPos
                            PopHeader.InputBegan:Connect(function(input)
                                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                                    popDragging = true
                                    pDragStart = input.Position
                                    pStartPos = Popup.Position
                                end
                            end)
                            PopHeader.InputEnded:Connect(function(input)
                                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                                    popDragging = false
                                end
                            end)
                            UserInputService.InputChanged:Connect(function(input)
                                if popDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                                    local delta = input.Position - pDragStart
                                    Popup.Position = UDim2.new(
                                        pStartPos.X.Scale, pStartPos.X.Offset + delta.X,
                                        pStartPos.Y.Scale, pStartPos.Y.Offset + delta.Y
                                    )
                                end
                            end)

                            local PopContainer = Instance.new("ScrollingFrame")
                            PopContainer.Size = UDim2.new(1, -12, 1, -32)
                            PopContainer.Position = UDim2.new(0, 6, 0, 28)
                            PopContainer.BackgroundTransparency = 1
                            PopContainer.BorderSizePixel = 0
                            PopContainer.ScrollBarThickness = 2
                            PopContainer.ScrollBarImageColor3 = Theme.Accent
                            PopContainer.AutomaticCanvasSize = Enum.AutomaticSize.Y
                            PopContainer.ZIndex = 902
                            PopContainer.Parent = Popup

                            local PopList = Instance.new("UIListLayout")
                            PopList.Padding = UDim.new(0, 4)
                            PopList.Parent = PopContainer

                            PopList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                                local newH = math.clamp(PopList.AbsoluteContentSize.Y + 38, 44, 260)
                                Popup.Size = UDim2.new(0, popupW, 0, newH)
                            end)
                            Popup.Size = UDim2.new(0, popupW, 0, 44)

                            ClickCatcher.MouseButton1Click:Connect(function()
                                if not popDragging then
                                    CloseAllPopups()
                                end
                            end)

                            for _, opt in ipairs(optionsTable) do
                                if opt.Type == "Toggle" then
                                    local pActive = (opt._Value ~= nil) and opt._Value or (opt.Default or false)

                                    local pFrame = Instance.new("Frame")
                                    pFrame.Size = UDim2.new(1, 0, 0, 22)
                                    pFrame.BackgroundTransparency = 1
                                    pFrame.ZIndex = 903
                                    pFrame.Parent = PopContainer

                                    local pLabel = Instance.new("TextLabel")
                                    pLabel.Size = UDim2.new(1, -34, 1, 0)
                                    pLabel.Position = UDim2.new(0, 2, 0, 0)
                                    pLabel.BackgroundTransparency = 1
                                    pLabel.Text = opt.Text
                                    pLabel.TextColor3 = pActive and Theme.Text or Theme.SubText
                                    pLabel.Font = Enum.Font.GothamMedium
                                    pLabel.TextSize = 10
                                    pLabel.TextXAlignment = Enum.TextXAlignment.Left
                                    pLabel.ZIndex = 904
                                    pLabel.Parent = pFrame

                                    local pSwitch = Instance.new("TextButton")
                                    pSwitch.Size = UDim2.new(0, 26, 0, 13)
                                    pSwitch.Position = UDim2.new(1, -28, 0.5, -6)
                                    pSwitch.BackgroundColor3 = pActive and Theme.Accent or Theme.Element
                                    pSwitch.Text = ""
                                    pSwitch.AutoButtonColor = false
                                    pSwitch.ZIndex = 904
                                    pSwitch.Parent = pFrame
                                    CreateCorner(pSwitch, 6)

                                    local pKnob = Instance.new("Frame")
                                    pKnob.Size = UDim2.new(0, 9, 0, 9)
                                    pKnob.Position = pActive and UDim2.new(1, -11, 0.5, -4) or UDim2.new(0, 2, 0.5, -4)
                                    pKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                                    pKnob.ZIndex = 905
                                    pKnob.Parent = pSwitch
                                    CreateCorner(pKnob, 4)

                                    pSwitch.MouseButton1Click:Connect(function()
                                        pActive = not pActive
                                        opt._Value = pActive
                                        TweenService:Create(pSwitch, TweenInfo.new(0.16), {BackgroundColor3 = pActive and Theme.Accent or Theme.Element}):Play()
                                        TweenService:Create(pLabel, TweenInfo.new(0.16), {TextColor3 = pActive and Theme.Text or Theme.SubText}):Play()
                                        TweenService:Create(pKnob, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                                            Position = pActive and UDim2.new(1, -11, 0.5, -4) or UDim2.new(0, 2, 0.5, -4)
                                        }):Play()
                                        if opt.Callback then pcall(opt.Callback, pActive) end
                                    end)

                                elseif opt.Type == "Slider" then
                                    local sMin = opt.Min or 0
                                    local sMax = opt.Max or 100
                                    local sVal = (opt._Value ~= nil) and opt._Value or math.clamp(opt.Default or sMin, sMin, sMax)

                                    local sFrame = Instance.new("Frame")
                                    sFrame.Size = UDim2.new(1, 0, 0, 28)
                                    sFrame.BackgroundTransparency = 1
                                    sFrame.ZIndex = 903
                                    sFrame.Parent = PopContainer

                                    local sLabel = Instance.new("TextLabel")
                                    sLabel.Size = UDim2.new(1, -40, 0, 14)
                                    sLabel.Position = UDim2.new(0, 2, 0, 0)
                                    sLabel.BackgroundTransparency = 1
                                    sLabel.Text = opt.Text
                                    sLabel.TextColor3 = Theme.SubText
                                    sLabel.Font = Enum.Font.GothamMedium
                                    sLabel.TextSize = 10
                                    sLabel.TextXAlignment = Enum.TextXAlignment.Left
                                    sLabel.ZIndex = 904
                                    sLabel.Parent = sFrame

                                    local sValBox = Instance.new("TextBox")
                                    sValBox.Size = UDim2.new(0, 32, 0, 14)
                                    sValBox.Position = UDim2.new(1, -34, 0, 0)
                                    sValBox.BackgroundColor3 = Theme.Element
                                    sValBox.Text = tostring(sVal)
                                    sValBox.TextColor3 = Theme.Accent
                                    sValBox.Font = Enum.Font.GothamBold
                                    sValBox.TextSize = 9
                                    sValBox.BorderSizePixel = 0
                                    sValBox.ClearTextOnFocus = false
                                    sValBox.ZIndex = 904
                                    sValBox.Parent = sFrame
                                    CreateCorner(sValBox, 3)

                                    local sBar = Instance.new("Frame")
                                    sBar.Size = UDim2.new(1, -4, 0, 3)
                                    sBar.Position = UDim2.new(0, 2, 0, 19)
                                    sBar.BackgroundColor3 = Theme.Element
                                    sBar.ZIndex = 904
                                    sBar.Parent = sFrame
                                    CreateCorner(sBar, 2)

                                    local sFill = Instance.new("Frame")
                                    sFill.Size = UDim2.new((sVal-sMin)/(sMax-sMin), 0, 1, 0)
                                    sFill.BackgroundColor3 = Theme.Accent
                                    sFill.ZIndex = 905
                                    sFill.Parent = sBar
                                    CreateCorner(sFill, 2)

                                    local sKnob = Instance.new("Frame")
                                    sKnob.Size = UDim2.new(0, 7, 0, 7)
                                    sKnob.Position = UDim2.new(1, -3, 0.5, -3)
                                    sKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                                    sKnob.ZIndex = 906
                                    sKnob.Parent = sFill
                                    CreateCorner(sKnob, 4)

                                    local function setSliderVal(newVal)
                                        sVal = math.clamp(math.floor(newVal), sMin, sMax)
                                        opt._Value = sVal
                                        sValBox.Text = tostring(sVal)
                                        sFill.Size = UDim2.new((sVal-sMin)/(sMax-sMin), 0, 1, 0)
                                        if opt.Callback then pcall(opt.Callback, sVal) end
                                    end

                                    sValBox.FocusLost:Connect(function()
                                        local n = tonumber(sValBox.Text)
                                        if n then setSliderVal(n) else sValBox.Text = tostring(sVal) end
                                    end)

                                    local sSliding = false
                                    sBar.InputBegan:Connect(function(input)
                                        if input.UserInputType == Enum.UserInputType.MouseButton1 then
                                            sSliding = true
                                            local p = math.clamp((input.Position.X - sBar.AbsolutePosition.X) / sBar.AbsoluteSize.X, 0, 1)
                                            setSliderVal(sMin + (sMax - sMin) * p)
                                        end
                                    end)
                                    UserInputService.InputEnded:Connect(function(input)
                                        if input.UserInputType == Enum.UserInputType.MouseButton1 then sSliding = false end
                                    end)
                                    UserInputService.InputChanged:Connect(function(input)
                                        if sSliding and input.UserInputType == Enum.UserInputType.MouseMovement then
                                            local p = math.clamp((input.Position.X - sBar.AbsolutePosition.X) / sBar.AbsoluteSize.X, 0, 1)
                                            setSliderVal(sMin + (sMax - sMin) * p)
                                        end
                                    end)

                                elseif opt.Type == "Button" then
                                    local pBtn = Instance.new("TextButton")
                                    pBtn.Size = UDim2.new(1, 0, 0, 20)
                                    pBtn.BackgroundColor3 = Theme.Element
                                    pBtn.Text = opt.Text
                                    pBtn.TextColor3 = Theme.Text
                                    pBtn.Font = Enum.Font.GothamBold
                                    pBtn.TextSize = 10
                                    pBtn.AutoButtonColor = false
                                    pBtn.ZIndex = 903
                                    pBtn.Parent = PopContainer
                                    CreateCorner(pBtn, 3)

                                    pBtn.MouseEnter:Connect(function()
                                        TweenService:Create(pBtn, TweenInfo.new(0.1), {BackgroundColor3 = Theme.ElementHover}):Play()
                                    end)
                                    pBtn.MouseLeave:Connect(function()
                                        TweenService:Create(pBtn, TweenInfo.new(0.1), {BackgroundColor3 = Theme.Element}):Play()
                                    end)
                                    pBtn.MouseButton1Click:Connect(function()
                                        if opt.Callback then pcall(opt.Callback) end
                                    end)
                                end
                            end
                        end)
                    end

                    UpdateSize()
                end

                -- 3. СЛАЙДЕР (МГНОВЕННЫЙ ОТКЛИК И ЧИСТЫЙ ДИЗАЙН)
                function Section:AddSlider(text, min, max, default, unit, callback)
                    if type(unit) == "function" then
                        callback = unit
                        unit = ""
                    end
                    unit = unit or ""

                    local val = default or min

                    local SFrame = Instance.new("Frame")
                    SFrame.Name = RandomString(8)
                    SFrame.Size = UDim2.new(1, 0, 0, 28)
                    SFrame.BackgroundTransparency = 1
                    SFrame.Parent = Container

                    local Title = Instance.new("TextLabel")
                    Title.Size = UDim2.new(1, -54, 0, 14)
                    Title.Position = UDim2.new(0, 0, 0, 0)
                    Title.BackgroundTransparency = 1
                    Title.Text = text
                    Title.TextColor3 = Theme.SubText
                    Title.Font = Enum.Font.GothamMedium
                    Title.TextSize = 11
                    Title.TextXAlignment = Enum.TextXAlignment.Left
                    Title.TextTruncate = Enum.TextTruncate.AtEnd
                    Title.Parent = SFrame

                    local ValueInput = Instance.new("TextBox")
                    ValueInput.Size = UDim2.new(0, 48, 0, 14)
                    ValueInput.Position = UDim2.new(1, -48, 0, 0)
                    ValueInput.BackgroundColor3 = Theme.Element
                    ValueInput.Text = tostring(val) .. unit
                    ValueInput.TextColor3 = Theme.Accent
                    ValueInput.Font = Enum.Font.GothamBold
                    ValueInput.TextSize = 10
                    ValueInput.ClearTextOnFocus = false
                    ValueInput.Parent = SFrame
                    CreateCorner(ValueInput, 3)

                    local Bar = Instance.new("Frame")
                    Bar.Size = UDim2.new(1, 0, 0, 3)
                    Bar.Position = UDim2.new(0, 0, 0, 19)
                    Bar.BackgroundColor3 = Theme.Element
                    Bar.Parent = SFrame
                    CreateCorner(Bar, 2)

                    local Fill = Instance.new("Frame")
                    Fill.Size = UDim2.new(math.clamp((val - min)/(max - min), 0, 1), 0, 1, 0)
                    Fill.BackgroundColor3 = Theme.Accent
                    Fill.Parent = Bar
                    CreateCorner(Fill, 2)

                    local Knob = Instance.new("Frame")
                    Knob.Size = UDim2.new(0, 8, 0, 8)
                    Knob.Position = UDim2.new(1, -4, 0.5, -4)
                    Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                    Knob.Parent = Fill
                    CreateCorner(Knob, 4)

                    local function setVal(newVal)
                        val = math.clamp(math.floor(newVal), min, max)
                        ValueInput.Text = tostring(val) .. unit
                        local pos = math.clamp((val - min) / (max - min), 0, 1)
                        Fill.Size = UDim2.new(pos, 0, 1, 0)
                        if callback then pcall(callback, val) end
                    end

                    ValueInput.FocusLost:Connect(function()
                        local cleanText = ValueInput.Text:gsub("[^%d%-]", "")
                        local num = tonumber(cleanText)
                        if num then
                            setVal(num)
                        else
                            ValueInput.Text = tostring(val) .. unit
                        end
                    end)

                    local sliding = false
                    Bar.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then
                            sliding = true
                            local pos = math.clamp((input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
                            setVal(min + ((max - min) * pos))
                        end
                    end)
                    UserInputService.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end
                    end)
                    UserInputService.InputChanged:Connect(function(input)
                        if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then
                            local pos = math.clamp((input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
                            setVal(min + ((max - min) * pos))
                        end
                    end)

                    UpdateSize()
                end

                -- 4. ТЕКСТОВОЕ ПОЛЕ
                function Section:AddTextBox(text, placeholder, callback)
                    local TBoxFrame = Instance.new("Frame")
                    TBoxFrame.Name = RandomString(8)
                    TBoxFrame.Size = UDim2.new(1, 0, 0, 24)
                    TBoxFrame.BackgroundColor3 = Theme.Element
                    TBoxFrame.Parent = Container
                    CreateCorner(TBoxFrame, 4)

                    local Input = Instance.new("TextBox")
                    Input.Size = UDim2.new(1, -12, 1, 0)
                    Input.Position = UDim2.new(0, 6, 0, 0)
                    Input.BackgroundTransparency = 1
                    Input.Text = ""
                    Input.PlaceholderText = placeholder or text
                    Input.PlaceholderColor3 = Theme.SubText
                    Input.TextColor3 = Theme.Text
                    Input.Font = Enum.Font.Gotham
                    Input.TextSize = 11
                    Input.TextXAlignment = Enum.TextXAlignment.Left
                    Input.Parent = TBoxFrame

                    Input.FocusLost:Connect(function()
                        if callback then pcall(callback, Input.Text) end
                    end)

                    UpdateSize()
                end

                return Section
            end

            table.insert(Tab.SubTabs, SubTab)
            
            if Window.ActiveTab == Tab and #Tab.SubTabs == 1 then
                SelectSubTab(Tab, SubTab)
            end

            return SubTab
        end

        table.insert(Window.Tabs, Tab)

        if #Window.Tabs == 1 then
            task.defer(function()
                SelectTab(Tab)
            end)
        end

        return Tab
    end

    -- =========================================================
    -- ШЕЛКОВИСТАЯ ПЛАВНАЯ АНИМАЦИЯ NEVERLOOSE (CANVAS GROUP SCALE-FADE)
    -- =========================================================
    local isOpen = true
    local animating = false

    local function HideMenu()
        if animating then return end
        animating = true
        CloseAllPopups()

        if Main:IsA("CanvasGroup") then
            TweenService:Create(Main, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
                GroupTransparency = 1
            }):Play()
        end

        TweenService:Create(MainScale, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Scale = 0.95
        }):Play()

        TweenService:Create(mainStroke, TweenInfo.new(0.16, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Transparency = 1
        }):Play()

        task.wait(0.18)
        Main.Visible = false
        isOpen = false
        animating = false
    end

    local function ShowMenu()
        if animating then return end
        animating = true

        Main.Visible = true
        if Main:IsA("CanvasGroup") then
            Main.GroupTransparency = 1
        end
        MainScale.Scale = 0.95
        mainStroke.Transparency = 1

        if Main:IsA("CanvasGroup") then
            TweenService:Create(Main, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                GroupTransparency = 0
            }):Play()
        end

        TweenService:Create(MainScale, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Scale = 1.0
        }):Play()

        TweenService:Create(mainStroke, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Transparency = 0.4,
            Color = Theme.CardStroke
        }):Play()

        task.wait(0.22)
        isOpen = true
        animating = false
    end

    local function ToggleMenu()
        if isOpen then
            HideMenu()
        else
            ShowMenu()
        end
    end

    UserInputService.InputBegan:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.RightShift then
            local focusedBox = UserInputService:GetFocusedTextBox()
            if not focusedBox then
                ToggleMenu()
            end
        end
    end)

    return Window
end

return VoltClips
