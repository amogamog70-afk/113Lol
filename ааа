    local function OpenModal(title, builderCallback)
        for _, child in ipairs(ModalContent:GetChildren()) do
            if not child:IsA("UIListLayout") then
                child:Destroy()
            end
        end

        ModalTitle.Text = title or "Settings"
        ModalOverlay.BackgroundTransparency = 1
        ModalOverlay.Visible = true

        ModalFrame.Size = UDim2.new(0, 320, 0, 240)
        ModalFrame.Position = UDim2.new(0.5, -160, 0.5, -120)

