    local function SelectSubTab(tab, targetSubTab)
        tab.ActiveSubTab = targetSubTab
        for _, st in ipairs(tab.SubTabs) do
            local isSubActive = (st == targetSubTab)
            st.Button.TextColor3 = isSubActive and Theme.Accent or Theme.SubText
            local ul = st.Button:FindFirstChild("Underline")
            if ul then
                ul.BackgroundTransparency = isSubActive and 0 or 1
            end
            st.Page.Visible = (tab == Window.ActiveTab and isSubActive)
        end
    end

    local function SelectTab(targetTab)
        Window.ActiveTab = targetTab
        CloseAllPopups()

        for _, t in ipairs(Window.Tabs) do
            local isTarget = (t == targetTab)
            
            TweenService:Create(t.Button, TweenInfo.new(0.15), {
                BackgroundColor3 = isTarget and Theme.Card or Theme.Element,
                BackgroundTransparency = isTarget and 0.2 or 1
            }):Play()
            TweenService:Create(t.Icon, TweenInfo.new(0.15), {
                ImageColor3 = isTarget and Theme.Accent or Theme.SubText
            }):Play()
            TweenService:Create(t.Title, TweenInfo.new(0.15), {
                TextColor3 = isTarget and Theme.Text or Theme.SubText
            }):Play()

            if t.Indicator then
                TweenService:Create(t.Indicator, TweenInfo.new(0.15), {
                    BackgroundTransparency = isTarget and 0 or 1
                }):Play()
            end

            for subIdx, st in ipairs(t.SubTabs) do
                st.Button.Visible = isTarget
                if st._Divider then
                    st._Divider.Visible = (isTarget and subIdx > 1)
                end
                if not isTarget then
                    st.Page.Visible = false
                end
            end

            if isTarget then
                if not t.ActiveSubTab and #t.SubTabs > 0 then
                    t.ActiveSubTab = t.SubTabs[1]
                end
                if t.ActiveSubTab then
                    SelectSubTab(t, t.ActiveSubTab)
                end
            end
        end
    end

