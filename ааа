                                    pFrame.ZIndex = 903
                                    pFrame.Parent = PopContainer
                                    CreateCorner(pFrame, 6)
                                    CreateStroke(pFrame, Theme.CardStroke, 1, 0.4)

                                    local pLabel = Instance.new("TextLabel")
                                    pLabel.Size = UDim2.new(1, -44, 1, 0)
                                    pLabel.Position = UDim2.new(0, 8, 0, 0)
                                    pLabel.BackgroundTransparency = 1
                                    pLabel.Text = opt.Text
                                    pLabel.TextColor3 = pActive and Theme.Accent or Theme.Text
                                    pLabel.Font = Enum.Font.GothamBold
                                    pLabel.TextSize = 10
                                    pLabel.TextXAlignment = Enum.TextXAlignment.Left
                                    pLabel.ZIndex = 904
                                    pLabel.Parent = pFrame

                                    local pSwitch = Instance.new("TextButton")
                                    pSwitch.Size = UDim2.new(0, 28, 0, 14)
                                    pSwitch.Position = UDim2.new(1, -34, 0.5, -7)
                                    pSwitch.BackgroundColor3 = pActive and Theme.Accent or Theme.Card
                                    pSwitch.Text = ""
                                    pSwitch.AutoButtonColor = false
                                    pSwitch.ZIndex = 904
                                    pSwitch.Parent = pFrame
                                    CreateCorner(pSwitch, 7)

                                    local pKnob = Instance.new("Frame")
                                    pKnob.Size = UDim2.new(0, 10, 0, 10)
                                    pKnob.Position = pActive and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)
                                    pKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                                    pKnob.ZIndex = 905
                                    pKnob.Parent = pSwitch
                                    CreateCorner(pKnob, 5)

                                    pSwitch.MouseButton1Click:Connect(function()
                                        pActive = not pActive
                                        TweenService:Create(pSwitch, TweenInfo.new(0.18), {BackgroundColor3 = pActive and Theme.Accent or Theme.Card}):Play()
                                        TweenService:Create(pLabel, TweenInfo.new(0.18), {TextColor3 = pActive and Theme.Accent or Theme.Text}):Play()
                                        TweenService:Create(pKnob, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                                            Position = pActive and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)
                                        }):Play()
                                        if opt.Callback then pcall(opt.Callback, pActive) end
                                    end)

                                elseif opt.Type == "Slider" then
                                    local sMin = opt.Min or 0
                                    local sMax = opt.Max or 100
                                    local sVal = math.clamp(opt.Default or sMin, sMin, sMax)

                                    local sFrame = Instance.new("Frame")
                                    sFrame.Size = UDim2.new(1, 0, 0, 36)
                                    sFrame.BackgroundColor3 = Theme.Element
                                    sFrame.BorderSizePixel = 0
                                    sFrame.ZIndex = 903
                                    sFrame.Parent = PopContainer
                                    CreateCorner(sFrame, 6)
                                    CreateStroke(sFrame, Theme.CardStroke, 1, 0.4)

                                    local sLabel = Instance.new("TextLabel")
                                    sLabel.Size = UDim2.new(1, -48, 0, 18)
                                    sLabel.Position = UDim2.new(0, 8, 0, 3)
                                    sLabel.BackgroundTransparency = 1
                                    sLabel.Text = opt.Text
                                    sLabel.TextColor3 = Theme.Text
                                    sLabel.Font = Enum.Font.GothamBold
                                    sLabel.TextSize = 10
                                    sLabel.TextXAlignment = Enum.TextXAlignment.Left
                                    sLabel.ZIndex = 904
                                    sLabel.Parent = sFrame

                                    local sValBox = Instance.new("TextBox")
                                    sValBox.Size = UDim2.new(0, 36, 0, 15)
                                    sValBox.Position = UDim2.new(1, -42, 0, 3)
                                    sValBox.BackgroundColor3 = Theme.Card
                                    sValBox.Text = tostring(sVal)
                                    sValBox.TextColor3 = Theme.Accent
                                    sValBox.Font = Enum.Font.GothamBlack
                                    sValBox.TextSize = 9
                                    sValBox.BorderSizePixel = 0
                                    sValBox.ClearTextOnFocus = false
                                    sValBox.ZIndex = 904
                                    sValBox.Parent = sFrame
                                    CreateCorner(sValBox, 4)

                                    local sBar = Instance.new("Frame")
                                    sBar.Size = UDim2.new(1, -16, 0, 3)
                                    sBar.Position = UDim2.new(0, 8, 0, 26)
                                    sBar.BackgroundColor3 = Theme.Card
                                    sBar.ZIndex = 904
                                    sBar.Parent = sFrame
                                    CreateCorner(sBar, 2)

                                    local sFill = Instance.new("Frame")
                                    sFill.Size = UDim2.new((sVal-sMin)/(sMax-sMin), 0, 1, 0)
                                    sFill.BackgroundColor3 = Theme.Accent
                                    sFill.ZIndex = 905
                                    sFill.Parent = sBar
                                    CreateCorner(sFill, 2)

                                    local sKnob = Instance.new("Frame")
                                    sKnob.Size = UDim2.new(0, 8, 0, 8)
                                    sKnob.Position = UDim2.new(1, -4, 0.5, -4)
                                    sKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                                    sKnob.ZIndex = 906
                                    sKnob.Parent = sFill
                                    CreateCorner(sKnob, 4)

                                    local function setSliderVal(newVal)
                                        sVal = math.clamp(math.floor(newVal), sMin, sMax)
                                        sValBox.Text = tostring(sVal)
                                        TweenService:Create(sFill, TweenInfo.new(0.06), {Size = UDim2.new((sVal-sMin)/(sMax-sMin), 0, 1, 0)}):Play()
                                        if opt.Callback then pcall(opt.Callback, sVal) end
                                    end

                                    sValBox.FocusLost:Connect(function()
                                        local n = tonumber(sValBox.Text)
                                        if n then setSliderVal(n) else sValBox.Text = tostring(sVal) end
                                    end)

                                    local sSliding = false
                                    sBar.InputBegan:Connect(function(input)
                                        if input.UserInputType == Enum.UserInputType.MouseButton1 then
                                            sSliding = true
                                            local p = math.clamp((input.Position.X - sBar.AbsolutePosition.X) / sBar.AbsoluteSize.X, 0, 1)
                                            setSliderVal(sMin + (sMax - sMin) * p)
                                        end
                                    end)
                                    UserInputService.InputEnded:Connect(function(input)
                                        if input.UserInputType == Enum.UserInputType.MouseButton1 then sSliding = false end
                                    end)
                                    UserInputService.InputChanged:Connect(function(input)
                                        if sSliding and input.UserInputType == Enum.UserInputType.MouseMovement then
                                            local p = math.clamp((input.Position.X - sBar.AbsolutePosition.X) / sBar.AbsoluteSize.X, 0, 1)
                                            setSliderVal(sMin + (sMax - sMin) * p)
                                        end
                                    end)

                                elseif opt.Type == "Button" then
                                    local pBtn = Instance.new("TextButton")
                                    pBtn.Size = UDim2.new(1, 0, 0, 24)
                                    pBtn.BackgroundColor3 = Theme.Element
                                    pBtn.Text = opt.Text
                                    pBtn.TextColor3 = Theme.Text
                                    pBtn.Font = Enum.Font.GothamBold
                                    pBtn.TextSize = 10
                                    pBtn.AutoButtonColor = false
                                    pBtn.ZIndex = 903
                                    pBtn.Parent = PopContainer
                                    CreateCorner(pBtn, 6)
                                    local pbStroke = CreateStroke(pBtn, Theme.CardStroke, 1, 0.4)

                                    pBtn.MouseEnter:Connect(function()
                                        TweenService:Create(pBtn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Card}):Play()
                                        TweenService:Create(pbStroke, TweenInfo.new(0.15), {Color = Theme.Accent, Transparency = 0.2}):Play()
                                    end)
                                    pBtn.MouseLeave:Connect(function()
                                        TweenService:Create(pBtn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Element}):Play()
                                        TweenService:Create(pbStroke, TweenInfo.new(0.15), {Color = Theme.CardStroke, Transparency = 0.4}):Play()
                                    end)
                                    pBtn.MouseButton1Click:Connect(function()
                                        if opt.Callback then pcall(opt.Callback) end
                                    end)
                                end
                            end
                        end)
                    end

                    UpdateSize()
                end

                -- 3. СЛАЙДЕР С АККУРАТНЫМ ОТОБРАЖЕНИЕМ
                function Section:AddSlider(text, min, max, default, unit, callback)
                    if type(unit) == "function" then
                        callback = unit
                        unit = ""
                    end
                    unit = unit or ""

                    local val = default or min

                    local SFrame = Instance.new("Frame")
                    SFrame.Name = RandomString(8)
                    SFrame.Size = UDim2.new(1, 0, 0, 32)
                    SFrame.BackgroundTransparency = 1
                    SFrame.Parent = Container

                    -- Верхняя строка: Заголовок слева, значение справа
                    local Title = Instance.new("TextLabel")
                    Title.Size = UDim2.new(1, -65, 0, 16)
                    Title.Position = UDim2.new(0, 0, 0, 0)
                    Title.BackgroundTransparency = 1
                    Title.Text = text
                    Title.TextColor3 = Theme.SubText
                    Title.Font = Enum.Font.GothamMedium
                    Title.TextSize = 11
                    Title.TextXAlignment = Enum.TextXAlignment.Left
                    Title.Parent = SFrame

                    local ValueBoxFrame = Instance.new("Frame")
                    ValueBoxFrame.Size = UDim2.new(0, 58, 0, 16)
                    ValueBoxFrame.Position = UDim2.new(1, -58, 0, 0)
                    ValueBoxFrame.BackgroundColor3 = Theme.Element
                    ValueBoxFrame.Parent = SFrame
                    CreateCorner(ValueBoxFrame, 4)
                    CreateStroke(ValueBoxFrame, Theme.CardStroke, 1, 0.4)

                    local ValueInput = Instance.new("TextBox")
                    ValueInput.Size = UDim2.new(1, -4, 1, 0)
                    ValueInput.Position = UDim2.new(0, 2, 0, 0)
                    ValueInput.BackgroundTransparency = 1
                    ValueInput.Text = tostring(val) .. unit
                    ValueInput.TextColor3 = Theme.Accent
                    ValueInput.Font = Enum.Font.GothamBold
                    ValueInput.TextSize = 9
                    ValueInput.ClearTextOnFocus = false
                    ValueInput.Parent = ValueBoxFrame

                    -- Нижняя строка: Полоса прокрутки
                    local Bar = Instance.new("Frame")
                    Bar.Size = UDim2.new(1, 0, 0, 4)
                    Bar.Position = UDim2.new(0, 0, 0, 22)
                    Bar.BackgroundColor3 = Theme.Element
                    Bar.Parent = SFrame
                    CreateCorner(Bar, 2)

                    local Fill = Instance.new("Frame")
                    Fill.Size = UDim2.new(math.clamp((val - min)/(max - min), 0, 1), 0, 1, 0)
                    Fill.BackgroundColor3 = Theme.Accent
                    Fill.Parent = Bar
                    CreateCorner(Fill, 2)

                    local Knob = Instance.new("Frame")
                    Knob.Size = UDim2.new(0, 10, 0, 10)
                    Knob.Position = UDim2.new(1, -5, 0.5, -5)
                    Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                    Knob.Parent = Fill
                    CreateCorner(Knob, 5)

                    local function setVal(newVal)
                        val = math.clamp(math.floor(newVal), min, max)
                        ValueInput.Text = tostring(val) .. unit
                        local pos = (val - min) / (max - min)
                        TweenService:Create(Fill, TweenInfo.new(0.06), {Size = UDim2.new(pos, 0, 1, 0)}):Play()
                        if callback then pcall(callback, val) end
                    end

                    ValueInput.FocusLost:Connect(function()
                        local cleanText = ValueInput.Text:gsub("[^%d%-]", "")
                        local num = tonumber(cleanText)
                        if num then
                            setVal(num)
                        else
                            ValueInput.Text = tostring(val) .. unit
                        end
                    end)

                    local sliding = false
                    Bar.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then
                            sliding = true
                            local pos = math.clamp((input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
                            setVal(min + ((max - min) * pos))
                        end
                    end)
                    UserInputService.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end
                    end)
                    UserInputService.InputChanged:Connect(function(input)
                        if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then
                            local pos = math.clamp((input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
                            setVal(min + ((max - min) * pos))
                        end
                    end)

                    UpdateSize()
                end

                -- 4. ТЕКСТОВОЕ ПОЛЕ
                function Section:AddTextBox(text, placeholder, callback)
                    local TBoxFrame = Instance.new("Frame")
                    TBoxFrame.Name = RandomString(8)
                    TBoxFrame.Size = UDim2.new(1, 0, 0, 26)
                    TBoxFrame.BackgroundColor3 = Theme.Element
                    TBoxFrame.Parent = Container
                    CreateCorner(TBoxFrame, 5)
                    local boxStroke = CreateStroke(TBoxFrame, Theme.CardStroke, 1, 0.5)

                    local Input = Instance.new("TextBox")
                    Input.Size = UDim2.new(1, -12, 1, 0)
                    Input.Position = UDim2.new(0, 6, 0, 0)
                    Input.BackgroundTransparency = 1
                    Input.Text = ""
                    Input.PlaceholderText = placeholder or text
                    Input.PlaceholderColor3 = Theme.SubText
                    Input.TextColor3 = Theme.Text
                    Input.Font = Enum.Font.Gotham
                    Input.TextSize = 11
                    Input.TextXAlignment = Enum.TextXAlignment.Left
                    Input.Parent = TBoxFrame

                    Input.Focused:Connect(function()
                        TweenService:Create(boxStroke, TweenInfo.new(0.15), {Color = Theme.Accent, Transparency = 0.2}):Play()
                    end)
                    Input.FocusLost:Connect(function()
                        TweenService:Create(boxStroke, TweenInfo.new(0.15), {Color = Theme.CardStroke, Transparency = 0.5}):Play()
                        if callback then pcall(callback, Input.Text) end
                    end)

                    UpdateSize()
                end

                return Section
            end

            table.insert(Tab.SubTabs, SubTab)
            
            -- Если это первый сабтаб активной вкладки, делаем его активным
            if Window.ActiveTab == Tab and #Tab.SubTabs == 1 then
                SelectSubTab(Tab, SubTab)
            end

            return SubTab
        end

        table.insert(Window.Tabs, Tab)

        -- Если это первый таб в окне, автоматически выбираем его
        if #Window.Tabs == 1 then
            task.defer(function()
                SelectTab(Tab)
            end)
        end

        return Tab
    end

    -- =========================================================
    -- СИСТЕМА АНИМАЦИИ: РАЗРЫВ НА ОСКОЛКИ И ПЛАВНАЯ СБОРКА
    -- =========================================================
    local isOpen = true
    local animating = false

    local function ShatterAndHide()
        if animating then return end
        animating = true
        CloseAllPopups()

        -- Создаем осколки на основе текущих видимых элементов окна
        local mainAbsPos = Main.AbsolutePosition
        local mainAbsSize = Main.AbsoluteSize
        local center = mainAbsPos + mainAbsSize / 2

        local shards = {}

        local function SpawnShard(absPos, absSize, bgCol, strokeCol, isSpecial)
            local shard = Instance.new("Frame")
            shard.Name = "Shard"
            shard.Size = UDim2.new(0, absSize.X, 0, absSize.Y)
            shard.Position = UDim2.new(0, absPos.X, 0, absPos.Y)
            shard.BackgroundColor3 = bgCol or Theme.Card
            shard.BackgroundTransparency = 0.15
            shard.BorderSizePixel = 0
            shard.ZIndex = 999
            shard.Parent = FXLayer
            CreateCorner(shard, isSpecial and 8 or 6)
            local sStroke = CreateStroke(shard, strokeCol or Theme.CardStroke, 1, 0.3)

            -- Вектор разрыва от центра
            local pieceCenter = absPos + absSize / 2
            local dir = (pieceCenter - center)
            if dir.Magnitude < 5 then
                dir = Vector2.new(math.random(-100, 100), math.random(-100, 100))
            end
            dir = dir.Unit

            local dist = math.random(260, 520)
            local targetPos = absPos + (dir * dist) + Vector2.new(math.random(-40, 40), math.random(-40, 40))
            local targetRot = math.random(-110, 110)

            table.insert(shards, {
                frame = shard,
                stroke = sStroke,
                targetPos = targetPos,
                targetRot = targetRot,
                origPos = absPos,
                origSize = absSize
            })
        end

        -- 1. Осколок сайдбара
        SpawnShard(Sidebar.AbsolutePosition, Sidebar.AbsoluteSize, Theme.Sidebar, Theme.Accent, true)
        
        -- 2. Осколок TopBar
        SpawnShard(TopBar.AbsolutePosition, TopBar.AbsoluteSize, Theme.Background, Theme.CardStroke, false)

        -- 3. Осколки всех видимых карточек (Cards)
        if Window.ActiveTab and Window.ActiveTab.ActiveSubTab then
            local page = Window.ActiveTab.ActiveSubTab.Page
            for _, col in pairs(page:GetChildren()) do
                if col:IsA("ScrollingFrame") then
                    for _, card in pairs(col:GetChildren()) do
                        if card:IsA("Frame") and card.Visible and card.AbsoluteSize.Y > 10 then
                            SpawnShard(card.AbsolutePosition, card.AbsoluteSize, Theme.Card, Theme.Accent, false)
                        end
                    end
                end
            end
        end

        -- 4. Дополнительные геометрические осколки разрыва (микро-фрагменты)
        for i = 1, 10 do
            local randW = math.random(20, 55)
            local randH = math.random(15, 45)
            local randX = mainAbsPos.X + math.random(20, math.max(30, mainAbsSize.X - 60))
            local randY = mainAbsPos.Y + math.random(20, math.max(30, mainAbsSize.Y - 50))
            SpawnShard(Vector2.new(randX, randY), Vector2.new(randW, randH), Theme.Element, Theme.Accent, false)
        end

        -- Моментально скрываем основное окно
        Main.Visible = false

        -- Запуск физической анимации взрыва/разрыва наружу
        for i, s in ipairs(shards) do
            local delay = math.random() * 0.05
            local dur = 0.28 + math.random() * 0.12
            task.delay(delay, function()
                if s.frame and s.frame.Parent then
                    TweenService:Create(s.frame, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                        Position = UDim2.new(0, s.targetPos.X, 0, s.targetPos.Y),
                        Rotation = s.targetRot,
                        Size = UDim2.new(0, s.origSize.X * 0.4, 0, s.origSize.Y * 0.4),
                        BackgroundTransparency = 1
                    }):Play()
                    TweenService:Create(s.stroke, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                        Transparency = 1
                    }):Play()
                end
            end)
        end

        task.wait(0.42)
        FXLayer:ClearAllChildren()
        isOpen = false
        animating = false
    end

    local function AssembleAndShow()
        if animating then return end
        animating = true

        local mainAbsPos = Main.AbsolutePosition
        local mainAbsSize = Main.AbsoluteSize
        local center = mainAbsPos + mainAbsSize / 2

        local shards = {}

        local function CreateAssembleShard(absPos, absSize, bgCol, strokeCol)
            local pieceCenter = absPos + absSize / 2
            local dir = (pieceCenter - center)
            if dir.Magnitude < 5 then
                dir = Vector2.new(math.random(-100, 100), math.random(-100, 100))
            end
            dir = dir.Unit

            local dist = math.random(280, 520)
            local startPos = absPos + (dir * dist) + Vector2.new(math.random(-50, 50), math.random(-50, 50))
            local startRot = math.random(-120, 120)

            local shard = Instance.new("Frame")
            shard.Name = "Shard"
            shard.Size = UDim2.new(0, absSize.X * 0.6, 0, absSize.Y * 0.6)
            shard.Position = UDim2.new(0, startPos.X, 0, startPos.Y)
            shard.Rotation = startRot
            shard.BackgroundColor3 = bgCol or Theme.Card
            shard.BackgroundTransparency = 1
            shard.BorderSizePixel = 0
            shard.ZIndex = 999
            shard.Parent = FXLayer
            CreateCorner(shard, 8)
            local sStroke = CreateStroke(shard, strokeCol or Theme.Accent, 1, 1)

            table.insert(shards, {
                frame = shard,
                stroke = sStroke,
                origPos = absPos,
                origSize = absSize
            })
        end

        -- Создаем прилетающие осколки
        CreateAssembleShard(Sidebar.AbsolutePosition, Sidebar.AbsoluteSize, Theme.Sidebar, Theme.Accent)
        CreateAssembleShard(TopBar.AbsolutePosition, TopBar.AbsoluteSize, Theme.Background, Theme.CardStroke)

        if Window.ActiveTab and Window.ActiveTab.ActiveSubTab then
            local page = Window.ActiveTab.ActiveSubTab.Page
            for _, col in pairs(page:GetChildren()) do
                if col:IsA("ScrollingFrame") then
                    for _, card in pairs(col:GetChildren()) do
                        if card:IsA("Frame") and card.Visible and card.AbsoluteSize.Y > 10 then
                            CreateAssembleShard(card.AbsolutePosition, card.AbsoluteSize, Theme.Card, Theme.Accent)
                        end
                    end
                end
            end
        end

        for i = 1, 8 do
            local randW = math.random(25, 60)
            local randH = math.random(20, 50)
            local randX = mainAbsPos.X + math.random(20, math.max(30, mainAbsSize.X - 60))
            local randY = mainAbsPos.Y + math.random(20, math.max(30, mainAbsSize.Y - 50))
            CreateAssembleShard(Vector2.new(randX, randY), Vector2.new(randW, randH), Theme.Element, Theme.Accent)
        end

        -- Анимация плавной и точной сборки всех частей в исходные места
        for _, s in ipairs(shards) do
            local delay = math.random() * 0.06
            local dur = 0.38 + math.random() * 0.08
            task.delay(delay, function()
                if s.frame and s.frame.Parent then
                    TweenService:Create(s.frame, TweenInfo.new(dur, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                        Position = UDim2.new(0, s.origPos.X, 0, s.origPos.Y),
                        Rotation = 0,
                        Size = UDim2.new(0, s.origSize.X, 0, s.origSize.Y),
                        BackgroundTransparency = 0.15
                    }):Play()
                    TweenService:Create(s.stroke, TweenInfo.new(dur, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                        Transparency = 0.3
                    }):Play()
                end
            end)
        end

        task.wait(0.44)

        -- Вспышка и появление настоящего окна
        Main.Visible = true
        FXLayer:ClearAllChildren()
        isOpen = true
        animating = false
    end

    local function ToggleMenu()
        if isOpen then
            ShatterAndHide()
        else
            AssembleAndShow()
        end
    end

    UserInputService.InputBegan:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.RightShift then
            local focusedBox = UserInputService:GetFocusedTextBox()
            if not focusedBox then
                ToggleMenu()
            end
        end
    end)

    return Window
end

return VoltClips
