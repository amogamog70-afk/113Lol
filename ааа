                                    -- Toggle в стиле основного меню
                                    local pActive = opt.Default or false

                                    local pFrame = Instance.new("Frame")
                                    pFrame.Size = UDim2.new(1, 0, 0, 28)
                                    pFrame.BackgroundColor3 = Theme.Element
                                    pFrame.BorderSizePixel = 0
                                    pFrame.ZIndex = 903
                                    pFrame.Parent = PopContainer
                                    CreateCorner(pFrame, 6)
                                    CreateStroke(pFrame, Theme.CardStroke, 1, 0.4)

                                    local pLabel = Instance.new("TextLabel")
                                    pLabel.Size = UDim2.new(1, -46, 1, 0)
                                    pLabel.Position = UDim2.new(0, 8, 0, 0)
                                    pLabel.BackgroundTransparency = 1
                                    pLabel.Text = opt.Text
                                    pLabel.TextColor3 = pActive and Theme.Accent or Theme.Text
                                    pLabel.Font = Enum.Font.GothamBold
                                    pLabel.TextSize = 10
                                    pLabel.TextXAlignment = Enum.TextXAlignment.Left
                                    pLabel.ZIndex = 904
                                    pLabel.Parent = pFrame

                                    local pSwitch = Instance.new("TextButton")
                                    pSwitch.Size = UDim2.new(0, 30, 0, 15)
                                    pSwitch.Position = UDim2.new(1, -36, 0.5, -7)
                                    pSwitch.BackgroundColor3 = pActive and Theme.Accent or Theme.Card
                                    pSwitch.Text = ""
                                    pSwitch.AutoButtonColor = false
                                    pSwitch.ZIndex = 904
                                    pSwitch.Parent = pFrame
                                    CreateCorner(pSwitch, 8)

                                    local pKnob = Instance.new("Frame")
                                    pKnob.Size = UDim2.new(0, 11, 0, 11)
                                    pKnob.Position = pActive and UDim2.new(1, -13, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)
                                    pKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                                    pKnob.ZIndex = 905
                                    pKnob.Parent = pSwitch
                                    CreateCorner(pKnob, 6)

                                    pSwitch.MouseButton1Click:Connect(function()
                                        pActive = not pActive
                                        TweenService:Create(pSwitch, TweenInfo.new(0.18), {BackgroundColor3 = pActive and Theme.Accent or Theme.Card}):Play()
                                        TweenService:Create(pLabel, TweenInfo.new(0.18), {TextColor3 = pActive and Theme.Accent or Theme.Text}):Play()
                                        TweenService:Create(pKnob, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                                            Position = pActive and UDim2.new(1, -13, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)
                                        }):Play()
                                        if opt.Callback then pcall(opt.Callback, pActive) end
                                    end)

                                elseif opt.Type == "Slider" then
                                    -- Slider в стиле основного меню
                                    local sMin = opt.Min or 0
                                    local sMax = opt.Max or 100
                                    local sVal = math.clamp(opt.Default or sMin, sMin, sMax)

                                    local sFrame = Instance.new("Frame")
                                    sFrame.Size = UDim2.new(1, 0, 0, 38)
                                    sFrame.BackgroundColor3 = Theme.Element
                                    sFrame.BorderSizePixel = 0
                                    sFrame.ZIndex = 903
                                    sFrame.Parent = PopContainer
                                    CreateCorner(sFrame, 6)
                                    CreateStroke(sFrame, Theme.CardStroke, 1, 0.4)

                                    local sLabel = Instance.new("TextLabel")
                                    sLabel.Size = UDim2.new(1, -50, 0, 18)
                                    sLabel.Position = UDim2.new(0, 8, 0, 4)
                                    sLabel.BackgroundTransparency = 1
                                    sLabel.Text = opt.Text
                                    sLabel.TextColor3 = Theme.Text
                                    sLabel.Font = Enum.Font.GothamBold
                                    sLabel.TextSize = 10
                                    sLabel.TextXAlignment = Enum.TextXAlignment.Left
                                    sLabel.ZIndex = 904
                                    sLabel.Parent = sFrame

                                    local sValBox = Instance.new("TextBox")
                                    sValBox.Size = UDim2.new(0, 38, 0, 16)
                                    sValBox.Position = UDim2.new(1, -44, 0, 4)
                                    sValBox.BackgroundColor3 = Theme.Card
                                    sValBox.Text = tostring(sVal)
                                    sValBox.TextColor3 = Theme.Accent
                                    sValBox.Font = Enum.Font.GothamBlack
                                    sValBox.TextSize = 10
                                    sValBox.BorderSizePixel = 0
                                    sValBox.ClearTextOnFocus = false
                                    sValBox.ZIndex = 904
                                    sValBox.Parent = sFrame
                                    CreateCorner(sValBox, 4)

                                    local sBar = Instance.new("Frame")
                                    sBar.Size = UDim2.new(1, -16, 0, 4)
                                    sBar.Position = UDim2.new(0, 8, 0, 28)
                                    sBar.BackgroundColor3 = Theme.Card
                                    sBar.ZIndex = 904
                                    sBar.Parent = sFrame
                                    CreateCorner(sBar, 2)

                                    local sFill = Instance.new("Frame")
                                    sFill.Size = UDim2.new((sVal-sMin)/(sMax-sMin), 0, 1, 0)
                                    sFill.BackgroundColor3 = Theme.Accent
                                    sFill.ZIndex = 905
                                    sFill.Parent = sBar
                                    CreateCorner(sFill, 2)

                                    local sKnob = Instance.new("Frame")
                                    sKnob.Size = UDim2.new(0, 10, 0, 10)
                                    sKnob.Position = UDim2.new(1, -5, 0.5, -5)
                                    sKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                                    sKnob.ZIndex = 906
                                    sKnob.Parent = sFill
                                    CreateCorner(sKnob, 5)

                                    local function setSliderVal(newVal)
                                        sVal = math.clamp(math.floor(newVal), sMin, sMax)
                                        sValBox.Text = tostring(sVal)
                                        TweenService:Create(sFill, TweenInfo.new(0.07), {Size = UDim2.new((sVal-sMin)/(sMax-sMin), 0, 1, 0)}):Play()
                                        if opt.Callback then pcall(opt.Callback, sVal) end
                                    end

                                    sValBox.FocusLost:Connect(function()
                                        local n = tonumber(sValBox.Text)
                                        if n then setSliderVal(n) else sValBox.Text = tostring(sVal) end
                                    end)

                                    local sSliding = false
                                    sBar.InputBegan:Connect(function(input)
                                        if input.UserInputType == Enum.UserInputType.MouseButton1 then
                                            sSliding = true
                                            local p = math.clamp((input.Position.X - sBar.AbsolutePosition.X) / sBar.AbsoluteSize.X, 0, 1)
                                            setSliderVal(sMin + (sMax - sMin) * p)
                                        end
                                    end)
                                    UserInputService.InputEnded:Connect(function(input)
                                        if input.UserInputType == Enum.UserInputType.MouseButton1 then sSliding = false end
                                    end)
                                    UserInputService.InputChanged:Connect(function(input)
                                        if sSliding and input.UserInputType == Enum.UserInputType.MouseMovement then
                                            local p = math.clamp((input.Position.X - sBar.AbsolutePosition.X) / sBar.AbsoluteSize.X, 0, 1)
                                            setSliderVal(sMin + (sMax - sMin) * p)
                                        end
                                    end)

                                elseif opt.Type == "Button" then
                                    local pBtn = Instance.new("TextButton")
                                    pBtn.Size = UDim2.new(1, 0, 0, 26)
                                    pBtn.BackgroundColor3 = Theme.Element
                                    pBtn.Text = opt.Text
                                    pBtn.TextColor3 = Theme.Text
                                    pBtn.Font = Enum.Font.GothamBold
                                    pBtn.TextSize = 10
                                    pBtn.AutoButtonColor = false
                                    pBtn.ZIndex = 903
                                    pBtn.Parent = PopContainer
                                    CreateCorner(pBtn, 6)
                                    local pbStroke = CreateStroke(pBtn, Theme.CardStroke, 1, 0.4)

                                    pBtn.MouseEnter:Connect(function()
                                        TweenService:Create(pBtn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Card}):Play()
                                        TweenService:Create(pbStroke, TweenInfo.new(0.15), {Color = Theme.Accent, Transparency = 0.2}):Play()
                                    end)
                                    pBtn.MouseLeave:Connect(function()
                                        TweenService:Create(pBtn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Element}):Play()
                                        TweenService:Create(pbStroke, TweenInfo.new(0.15), {Color = Theme.CardStroke, Transparency = 0.4}):Play()
                                    end)
                                    pBtn.MouseButton1Click:Connect(function()
                                        if opt.Callback then pcall(opt.Callback) end
                                    end)
                                end
                            end
                        end)
                    end

                    UpdateSize()
                end

                -- 3. СЛАЙДЕР
                function Section:AddSlider(text, min, max, default, unit, callback)
                    if type(unit) == "function" then
                        callback = unit
                        unit = ""
                    end
                    unit = unit or ""

                    local val = default or min

                    local SFrame = Instance.new("Frame")
                    SFrame.Name = RandomString(8)
                    SFrame.Size = UDim2.new(1, 0, 0, 26)
                    SFrame.BackgroundTransparency = 1
                    SFrame.Parent = Container

                    local Title = Instance.new("TextLabel")
                    Title.Size = UDim2.new(0.42, 0, 1, 0)
                    Title.BackgroundTransparency = 1
                    Title.Text = text
                    Title.TextColor3 = Theme.SubText
                    Title.Font = Enum.Font.GothamMedium
                    Title.TextSize = 11
                    Title.TextXAlignment = Enum.TextXAlignment.Left
                    Title.Parent = SFrame

                    local RightGroup = Instance.new("Frame")
                    RightGroup.Size = UDim2.new(0.58, 0, 1, 0)
                    RightGroup.Position = UDim2.new(0.42, 0, 0, 0)
                    RightGroup.BackgroundTransparency = 1
                    RightGroup.Parent = SFrame

                    local ValueBoxFrame = Instance.new("Frame")
                    ValueBoxFrame.Size = UDim2.new(0, 42, 0, 18)
                    ValueBoxFrame.Position = UDim2.new(1, -42, 0.5, -9)
                    ValueBoxFrame.BackgroundColor3 = Theme.Element
                    ValueBoxFrame.Parent = RightGroup
                    CreateCorner(ValueBoxFrame, 5)
                    CreateStroke(ValueBoxFrame, Theme.CardStroke, 1, 0.4)

                    local ValueInput = Instance.new("TextBox")
                    ValueInput.Size = UDim2.new(1, 0, 1, 0)
                    ValueInput.BackgroundTransparency = 1
                    ValueInput.Text = tostring(val) .. unit
                    ValueInput.TextColor3 = Theme.Accent
                    ValueInput.Font = Enum.Font.GothamBold
                    ValueInput.TextSize = 10
                    ValueInput.Parent = ValueBoxFrame

                    local Bar = Instance.new("Frame")
                    Bar.Size = UDim2.new(1, -50, 0, 3)
                    Bar.Position = UDim2.new(0, 0, 0.5, -1)
                    Bar.BackgroundColor3 = Theme.Element
                    Bar.Parent = RightGroup
                    CreateCorner(Bar, 2)

                    local Fill = Instance.new("Frame")
                    Fill.Size = UDim2.new((val - min)/(max - min), 0, 1, 0)
                    Fill.BackgroundColor3 = Theme.Accent
                    Fill.Parent = Bar
                    CreateCorner(Fill, 2)

                    local Knob = Instance.new("Frame")
                    Knob.Size = UDim2.new(0, 9, 0, 9)
                    Knob.Position = UDim2.new(1, -4, 0.5, -4)
                    Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                    Knob.Parent = Fill
                    CreateCorner(Knob, 5)

                    local function setVal(newVal)
                        val = math.clamp(math.floor(newVal), min, max)
                        ValueInput.Text = tostring(val) .. unit
                        local pos = (val - min) / (max - min)
                        TweenService:Create(Fill, TweenInfo.new(0.08), {Size = UDim2.new(pos, 0, 1, 0)}):Play()
                        if callback then pcall(callback, val) end
                    end

                    ValueInput.FocusLost:Connect(function()
                        local cleanText = ValueInput.Text:gsub("%D", "")
                        local num = tonumber(cleanText)
                        if num then
                            setVal(num)
                        else
                            ValueInput.Text = tostring(val) .. unit
                        end
                    end)

                    local sliding = false
                    Bar.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then
                            sliding = true
                            local pos = math.clamp((input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
                            setVal(min + ((max - min) * pos))
                        end
                    end)
                    UserInputService.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end
                    end)
                    UserInputService.InputChanged:Connect(function(input)
                        if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then
                            local pos = math.clamp((input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
                            setVal(min + ((max - min) * pos))
                        end
                    end)

                    UpdateSize()
                end

                -- 4. ТЕКСТБОКС
                function Section:AddTextBox(text, placeholder, callback)
                    local TBoxFrame = Instance.new("Frame")
                    TBoxFrame.Name = RandomString(8)
                    TBoxFrame.Size = UDim2.new(1, 0, 0, 24)
                    TBoxFrame.BackgroundColor3 = Theme.Element
                    TBoxFrame.Parent = Container
                    CreateCorner(TBoxFrame, 5)
                    local boxStroke = CreateStroke(TBoxFrame, Theme.CardStroke, 1, 0.5)

                    local Input = Instance.new("TextBox")
                    Input.Size = UDim2.new(1, -10, 1, 0)
                    Input.Position = UDim2.new(0, 5, 0, 0)
                    Input.BackgroundTransparency = 1
                    Input.Text = ""
                    Input.PlaceholderText = placeholder or text
                    Input.PlaceholderColor3 = Theme.SubText
                    Input.TextColor3 = Theme.Text
                    Input.Font = Enum.Font.Gotham
                    Input.TextSize = 11
                    Input.TextXAlignment = Enum.TextXAlignment.Left
                    Input.Parent = TBoxFrame

                    Input.Focused:Connect(function()
                        TweenService:Create(boxStroke, TweenInfo.new(0.15), {Color = Theme.Accent, Transparency = 0.2}):Play()
                    end)
                    Input.FocusLost:Connect(function()
                        TweenService:Create(boxStroke, TweenInfo.new(0.15), {Color = Theme.CardStroke, Transparency = 0.5}):Play()
                        if callback then pcall(callback, Input.Text) end
                    end)

                    UpdateSize()
                end

                return Section
            end

            SubBtn.MouseButton1Click:Connect(function()
                CloseAllPopups()
                for _, st in pairs(Tab.SubTabs) do
                    TweenService:Create(st.Button, TweenInfo.new(0.15), {TextColor3 = Theme.SubText}):Play()
                    local ul = st.Button:FindFirstChild("Underline")
                    if ul then TweenService:Create(ul, TweenInfo.new(0.15), {BackgroundTransparency = 1}):Play() end
                    st.Page.Visible = false
                    if st._Divider then st._Divider.Visible = true end
                end
                TweenService:Create(SubBtn, TweenInfo.new(0.15), {TextColor3 = Theme.Accent}):Play()
                TweenService:Create(Underline, TweenInfo.new(0.15), {BackgroundTransparency = 0}):Play()
                Page.Visible = true
            end)

            table.insert(Tab.SubTabs, SubTab)
            if #Tab.SubTabs == 1 then
                SubBtn.TextColor3 = Theme.Accent
                Underline.BackgroundTransparency = 0
                Page.Visible = true
            end
            if SubTab._Divider then SubTab._Divider.Visible = true end

            return SubTab
        end

        TabBtn.MouseButton1Click:Connect(function()
            CloseAllPopups()
            for _, t in pairs(Tabs) do
                TweenService:Create(t.Button, TweenInfo.new(0.15), {ImageColor3 = Theme.SubText}):Play()
                t.Button.Parent.BackgroundTransparency = 1
                for _, st in pairs(t.SubTabs) do
                    st.Button.Visible = false
                    st.Page.Visible = false
                    if st._Divider then st._Divider.Visible = false end
                    local ul = st.Button:FindFirstChild("Underline")
                    if ul then ul.BackgroundTransparency = 1 end
                end
            end
            TweenService:Create(TabBtn, TweenInfo.new(0.15), {ImageColor3 = Theme.Accent}):Play()
            TabBtnBg.BackgroundTransparency = 0.78
            TabBtnBg.BackgroundColor3 = Theme.Accent

            for _, st in pairs(Tab.SubTabs) do
                st.Button.Visible = true
                if st._Divider then st._Divider.Visible = true end
            end
            if #Tab.SubTabs > 0 then
                Tab.SubTabs[1].Page.Visible = true
                TweenService:Create(Tab.SubTabs[1].Button, TweenInfo.new(0.15), {TextColor3 = Theme.Accent}):Play()
                local ul = Tab.SubTabs[1].Button:FindFirstChild("Underline")
                if ul then TweenService:Create(ul, TweenInfo.new(0.15), {BackgroundTransparency = 0}):Play() end
            end
        end)

        table.insert(Tabs, Tab)
        if #Tabs == 1 then
            TweenService:Create(TabBtn, TweenInfo.new(0), {ImageColor3 = Theme.Accent}):Play()
            TabBtnBg.BackgroundTransparency = 0.78
            TabBtnBg.BackgroundColor3 = Theme.Accent
        end

        return Tab
    end

    -- =========================================================
    -- Анимация разрушения/сборки (тоггл — Right Shift)
    -- =========================================================
    local isOpen = true
    local animating = false

    local function ToggleMenu()
        if animating then return end
        animating = true
        CloseAllPopups()

        if isOpen then
            -- === РАЗБИТИЕ (ОСКОЛКИ) ===
            -- Размываем основной фрейм
            TweenService:Create(Main, TweenInfo.new(0.06, Enum.EasingStyle.Quad), {
                BackgroundTransparency = 1
            }):Play()
            TweenService:Create(mainStroke, TweenInfo.new(0.06), {
                Transparency = 1
            }):Play()

            -- Каждый осколок летит в свою сторону
            local delays = {}
            for i, sp in ipairs(ShatterPieces) do
                local piece = sp.piece
                if piece and piece.Parent then
                    -- Угол вылета равномерно во все стороны
                    local angle = math.random(0, 360) * (math.pi / 180)
                    local dist = math.random(200, 600)
                    local dx = math.cos(angle) * dist
                    local dy = math.sin(angle) * dist
                    local rot = math.random(-180, 180)
                    local dur = 0.28 + math.random() * 0.18
                    local delay = math.random() * 0.08  -- стаггер

                    delays[i] = delay

                    task.delay(delay, function()
                        if piece and piece.Parent then
                            TweenService:Create(piece, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                                Position = piece.Position + UDim2.new(0, dx, 0, dy),
                                Rotation = rot,
                                BackgroundTransparency = 1,
                            }):Play()
                        end
                    end)
                end
            end

            task.wait(0.55)
            Main.Visible = false
            -- Сбрасываем осколки без анимации чтобы следующая анимация была чистой
            for _, sp in ipairs(ShatterPieces) do
                local piece = sp.piece
                if piece and piece.Parent then
                    piece.Position = sp.origPos
                    piece.Size = sp.origSize
                    piece.Rotation = 0
                    piece.BackgroundTransparency = sp.origTransparency or 0
                end
            end
            isOpen = false

        else
            -- === СБОРКА (плавная) ===
            -- Сначала бросаем осколки во все стороны и делаем прозрачными
            for _, sp in ipairs(ShatterPieces) do
                local piece = sp.piece
                if piece and piece.Parent then
                    local angle = math.random(0, 360) * (math.pi / 180)
                    local dist = math.random(180, 500)
                    piece.Position = sp.origPos + UDim2.new(0, math.cos(angle) * dist, 0, math.sin(angle) * dist)
                    piece.Rotation = math.random(-160, 160)
                    piece.BackgroundTransparency = 1
                end
            end

            Main.Visible = true
            TweenService:Create(Main, TweenInfo.new(0.22, Enum.EasingStyle.Quad), {
                BackgroundTransparency = 0
            }):Play()
            TweenService:Create(mainStroke, TweenInfo.new(0.22), {
                Transparency = 0.2
            }):Play()

            -- Осколки собираются обратно с приятным Elastic
            for i, sp in ipairs(ShatterPieces) do
                local piece = sp.piece
                if piece and piece.Parent then
                    local delay = math.random() * 0.06
                    task.delay(delay, function()
                        if piece and piece.Parent then
                            TweenService:Create(piece,
                                TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                                {
                                    Position = sp.origPos,
                                    Rotation = 0,
                                    BackgroundTransparency = sp.origTransparency or 0,
                                }
                            ):Play()
                        end
                    end)
                end
            end

            task.wait(0.52)
            isOpen = true
        end

        animating = false
    end

    UserInputService.InputBegan:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.RightShift then
            local focusedBox = UserInputService:GetFocusedTextBox()
            if not focusedBox then
                ToggleMenu()
            end
        end
    end)

    return Window
end

return VoltClips
